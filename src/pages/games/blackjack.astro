---
import CasinoLayout from '../../layouts/casino.astro';
import DecoIcon from '../../components/DecoIcon.astro';
import '../../styles/blackjack.css';
import CardContainer from '../../components/CardContainer.astro';
import SplitHandsContainer from '../../components/SplitHandsContainer.astro';
import { createPublicGameSession } from '../../lib/public-game-session';
import { blackjackTranslator } from '../../lib/i18n/messages/blackjack';
import { getGameName } from '../../lib/i18n/messages/games';
import { formatChips } from '../../lib/i18n/messages/common';

const user = Astro.locals.user;
const locale = Astro.locals.locale;
const t = blackjackTranslator(locale);
const gameSession = createPublicGameSession(user);
const initialBalance = gameSession.initialBalance;
// Opaque per-user surrogate: 'anonymous' for guests, a non-reversible hash for
// authenticated users. The raw account id is never rendered into the DOM.
const clientUserId = gameSession.clientUserId;
---

<CasinoLayout
	title={t('pageTitle', { game: getGameName(locale, 'blackjack') })}
	footerClass="hidden"
>
	<div
		id="blackjack-root"
		data-user-id={clientUserId}
		data-guest-mode={gameSession.guestModeValue}
		data-initial-balance={initialBalance}
		class="blackjack-cabinet"
	>
		<div class="cabinet-interior">
			<div class="cabinet-rays" aria-hidden="true"></div>
			<header class="cabinet-header">
				<a href="/games" class="cabinet-back"><span aria-hidden="true">‹</span>{t('backToGames')}</a
				>
				<div class="cabinet-title">
					<span class="cabinet-star"><DecoIcon name="star" size={18} /></span><h1>
						{getGameName(locale, 'blackjack')}
					</h1><span class="cabinet-mode">{t('casual')}</span>
				</div>
				<div class="cabinet-tools">
					<div class="cabinet-payout" title={t('payoutBlackjack')}>
						<span>{t('pays')}</span><strong>3 : 2</strong>
					</div>
					<button
						id="btn-toggle-settings"
						class="cabinet-icon"
						title={t('gameSettings')}
						aria-label={t('gameSettings')}
						aria-controls="settings-panel"
						aria-expanded="false"
						><svg
							width="17"
							height="17"
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="1.5"
							aria-hidden="true"><path d="M4 7h16M4 17h16M8 4v6M16 14v6"></path></svg
						></button
					>
					<details class="cabinet-menu">
						<summary class="cabinet-icon" aria-label={t('gameRules')} title={t('gameRules')}
							>?</summary
						>
						<div class="cabinet-popover">
							<h2>{t('gameRules')}</h2>
							<ul>
								<li>{t('ruleBeatDealer')}</li><li>{t('ruleFaceCards')}</li><li>
									{t('ruleAces')}
								</li><li>{t('ruleBust')}</li><li>{t('dealerStands')}</li>
							</ul>
							<h2>{t('actions')}</h2>
							<ul>
								<li>{t('actionHitLine', { action: t('hit') })}</li><li>
									{t('actionStandLine', { action: t('stand') })}
								</li><li>{t('actionDoubleLine', { action: t('doubleDown') })}</li><li>
									{t('actionSplitLine', { action: t('split') })}
								</li>
							</ul>
							<h2>{t('payouts')}</h2>
							<ul>
								<li>{t('payoutBlackjack')}</li><li>{t('payoutWin')}</li><li>{t('payoutPush')}</li>
							</ul>
						</div>
					</details>
					<details class="cabinet-menu">
						<summary class="cabinet-icon" aria-label={t('moreModes')} title={t('moreModes')}
							><DecoIcon name="menu" size={16} /></summary
						>
						<nav class="cabinet-popover cabinet-mode-links" aria-label={t('moreModes')}>
							{
								user ? (
									<a href="/games/blackjack/ranked" data-testid="ranked-blackjack-link">
										{t('playRanked', { game: getGameName(locale, 'blackjack-ranked') })}
									</a>
								) : (
									<a href="/signin" data-testid="ranked-blackjack-signin">
										{t('rankedRequiresAccount', { game: getGameName(locale, 'blackjack-ranked') })}
									</a>
								)
							}
							<a href="/games/daily-challenge" data-testid="daily-challenge-link"
								>{t('tryDailyChallenge')}</a
							>
						</nav>
					</details>
				</div>
			</header>
			<section
				class="cabinet-table"
				aria-label={t('tableAriaLabel', { game: getGameName(locale, 'blackjack') })}
			>
				<div class="cabinet-dealer-row">
					<div class="cabinet-dealer-plaque">
						<div class="cabinet-dealer-emblem" aria-hidden="true">
							<DecoIcon name="star" size={36} /><span>21</span><span class="cabinet-suits"
								>♠ ♥ ♦ ♣</span
							>
						</div>
						<span class="cabinet-dealer-tag">{t('dealer')}</span><span class="cabinet-dealer-rule"
							>{t('dealerStands')}</span
						>
					</div>
					<div class="cabinet-dealer-hand">
						<CardContainer id="dealer-cards" maxCards={10} size="normal" detailed /><div
							class="cabinet-dealer-score"
						>
							<span id="dealer-value">–</span><span class="cabinet-label">{t('dealer')}</span>
						</div>
					</div>
				</div>
				<div class="cabinet-divider cabinet-table-divider" aria-hidden="true">
					<i></i><i></i><i></i>
				</div>
				<div class="cabinet-player-row">
					<div class="cabinet-score">
						<div>
							<span id="player-value">–</span><span class="cabinet-label">{t('yourHand')}</span>
						</div>
					</div>
					<div class="cabinet-player-hands">
						<div id="player-cards-single">
							<CardContainer id="player-cards" maxCards={10} size="normal" detailed />
						</div><SplitHandsContainer
							id="player-cards-split"
							maxHands={4}
							maxCardsPerHand={10}
							detailed
						/>
					</div>
					<div class="cabinet-wager">
						<DecoIcon name="chip" size={28} /><div id="current-bet">
							{t('currentBet', { amount: formatChips(0, locale) })}
						</div><span class="cabinet-label"
							>{gameSession.isGuest ? t('guestBalance') : t('yourBalance')}</span
						><div id="player-balance">{formatChips(initialBalance, locale)}</div>
					</div>
				</div>
				<div class="cabinet-status">
					<div id="game-status" role="status" aria-live="polite">{t('placeBet')}</div>
				</div>
				<div class="cabinet-advisor">
					<button id="btn-ai-rival" class="cabinet-advice-button" title={t('aiAdvisorTitle')}
						><DecoIcon name="star" size={14} /><span id="btn-ai-rival-text">{t('askAiRival')}</span
						></button
					>
					<div id="ai-advice-box" class="hidden">
						<div id="ai-advice-action"></div><div id="ai-advice-reasoning"></div>
					</div>
				</div>
			</section>
			<section class="cabinet-controls" aria-label={t('actions')}>
				<div class="cabinet-divider" aria-hidden="true"><i></i><i></i><i></i></div>
				<div id="betting-controls">
					<button
						id="btn-deal"
						class="cabinet-button cabinet-button-gold"
						aria-label={t('dealAriaLabel')}
						><span aria-hidden="true">♠</span>{t('dealButton')}</button
					>
				</div>
				<div id="game-controls" class="hidden">
					<div class="cabinet-actions">
						<button id="btn-hit" class="cabinet-button"
							><span aria-hidden="true">＋</span>{t('hitButton')}</button
						>
						<button id="btn-stand" class="cabinet-button cabinet-button-gold"
							><span aria-hidden="true">−</span>{t('standButton')}</button
						>
						<button
							id="btn-double"
							class="cabinet-button cabinet-button-purple"
							title={t('doubleTip')}
							aria-label={t('doubleAriaLabel')}
							><span aria-hidden="true">»</span>{t('doubleButton')}</button
						>
						<button id="btn-split" class="cabinet-button" title={t('splitTip')}
							><span aria-hidden="true">⑂</span>{t('splitButton')}</button
						>
						<button id="btn-new-round" class="hidden cabinet-button cabinet-button-gold"
							>{t('newRoundButton')}</button
						>
					</div>
				</div>
				<div class="cabinet-bets">
					<label class="cabinet-label" for="bet-amount">{t('nextBet')}</label>
					{
						[25, 50, 100, 200].map((amount) => (
							<button
								class="bet-quick cabinet-preset"
								data-amount={amount}
								aria-pressed={amount === 50}
							>
								{amount}
							</button>
						))
					}
					<div class="cabinet-custom-bet">
						<DecoIcon name="chip" size={14} /><input
							type="number"
							id="bet-amount"
							min="10"
							max="500"
							value="50"
							step="1"
							aria-label={t('betAmount')}
						/>
					</div>
					<button id="btn-rebet" class="cabinet-preset">{t('rebet')}</button><button
						id="btn-max-bet"
						class="cabinet-preset">{t('maxBet')}</button
					>
				</div>
				<div
					id="settings-panel"
					class="hidden mt-4 bg-[var(--deco-obsidian-2)] rounded-xl p-6 border border-[var(--deco-line)]"
				>
					<h3 class="text-xl font-bold text-[var(--deco-brass)] mb-4">{t('gameSettings')}</h3>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						<!-- Betting Limits -->
						<div class="space-y-4">
							<h4 class="text-sm font-semibold text-[var(--deco-muted)] uppercase tracking-wide">
								{t('bettingLimits')}
							</h4>
							<div>
								<label
									for="setting-starting-chips"
									class="block text-sm text-[var(--deco-muted)] mb-1">{t('startingChips')}</label
								>
								<input
									type="number"
									id="setting-starting-chips"
									min="100"
									max="100000"
									value="1000"
									class="w-full bg-[var(--deco-obsidian)] border border-[var(--deco-line)] rounded-lg px-4 py-2 text-[var(--deco-ivory)] focus:border-[var(--deco-brass)] focus:outline-none"
								/>
							</div>
							<div>
								<label for="setting-min-bet" class="block text-sm text-[var(--deco-muted)] mb-1"
									>{t('minimumBet')}</label
								>
								<input
									type="number"
									id="setting-min-bet"
									min="1"
									max="1000"
									value="10"
									class="w-full bg-[var(--deco-obsidian)] border border-[var(--deco-line)] rounded-lg px-4 py-2 text-[var(--deco-ivory)] focus:border-[var(--deco-brass)] focus:outline-none"
								/>
							</div>
							<div>
								<label for="setting-max-bet" class="block text-sm text-[var(--deco-muted)] mb-1"
									>{t('maximumBet')}</label
								>
								<input
									type="number"
									id="setting-max-bet"
									min="10"
									max="10000"
									value="1000"
									class="w-full bg-[var(--deco-obsidian)] border border-[var(--deco-line)] rounded-lg px-4 py-2 text-[var(--deco-ivory)] focus:border-[var(--deco-brass)] focus:outline-none"
								/>
							</div>
						</div>

						<!-- Game Options -->
						<div class="space-y-4">
							<h4 class="text-sm font-semibold text-[var(--deco-muted)] uppercase tracking-wide">
								{t('gameOptions')}
							</h4>
							<div>
								<label
									for="setting-dealer-speed"
									class="block text-sm text-[var(--deco-muted)] mb-1">{t('dealerSpeed')}</label
								>
								<select
									id="setting-dealer-speed"
									class="w-full bg-[var(--deco-obsidian)] border border-[var(--deco-line)] rounded-lg px-4 py-2 text-[var(--deco-ivory)] focus:border-[var(--deco-brass)] focus:outline-none"
								>
									<option value="slow">{t('dealerSpeedSlow')}</option>
									<option value="normal" selected>{t('dealerSpeedNormal')}</option>
									<option value="fast">{t('dealerSpeedFast')}</option>
								</select>
							</div>
						</div>
					</div>

					<!-- Settings Actions -->
					<div class="mt-6 flex gap-3">
						<button
							id="btn-save-settings"
							class="flex-1 bg-linear-to-r from-[var(--deco-brass-bright)] to-[var(--deco-brass)] text-[var(--deco-obsidian)] font-bold py-3 px-6 rounded-lg transition-all"
						>
							{t('saveSettings')}
						</button>
						<button
							id="btn-reset-settings"
							class="flex-1 bg-[var(--deco-obsidian-3)] hover:bg-[var(--deco-line)] text-[var(--deco-ivory-dim)] font-bold py-3 px-6 rounded-lg transition-colors border border-[var(--deco-line)]"
						>
							{t('resetToDefaults')}
						</button>
					</div>
				</div>
			</section>
		</div>
	</div>
	<!-- Achievement Toast Notification -->
	<div
		id="achievement-toast"
		role="status"
		aria-live="polite"
		aria-atomic="true"
		class="fixed bottom-4 right-4 bg-linear-to-r from-[var(--deco-brass-bright)] to-[var(--deco-brass)] text-[var(--deco-obsidian)] px-5 py-4 rounded-xl shadow-2xl flex items-center gap-3 transition-all duration-300 opacity-0 pointer-events-none translate-y-4"
		style="z-index: 9999;"
	>
		<span id="achievement-icon" class="text-3xl">🏆</span>
		<div>
			<p class="text-xs font-semibold uppercase tracking-wider opacity-80">
				{t('achievementUnlocked')}
			</p>
			<p id="achievement-name" class="font-bold text-lg">Achievement Name</p>
		</div>
	</div>
</CasinoLayout>

<script>
	import { initBlackjackClient } from '../../lib/blackjack/blackjackClient';
	import { initAchievementToast } from '../../lib/achievement-toast';

	initBlackjackClient();

	// Achievement toast notification handler
	const achievementToast = document.getElementById('achievement-toast');
	const achievementIcon = document.getElementById('achievement-icon');
	const achievementName = document.getElementById('achievement-name');

	let enqueue: (achievements: Array<{ id: string; icon: string }>) => void;

	if (achievementToast && achievementIcon && achievementName) {
		const controller = initAchievementToast(() => ({
			toast: achievementToast,
			icon: achievementIcon,
			name: achievementName,
		}));
		enqueue = controller.enqueue;
	} else {
		// No-op if elements are missing
		enqueue = () => {};
	}

	window.addEventListener('achievement-earned', (event: Event) => {
		const customEvent = event as CustomEvent<{
			achievements: Array<{ id: string; icon: string }>;
		}>;
		const { achievements } = customEvent.detail;
		// Validate achievements is an array before calling enqueue
		if (Array.isArray(achievements)) {
			enqueue(achievements);
		}
	});
</script>
