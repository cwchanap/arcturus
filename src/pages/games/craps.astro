</style>

<script>
	import {
		buildCrapsSettlementCommand,
		getAvailableCrapsBalance,
	} from '../../lib/craps/settlement';
	import { CrapsGame } from '../../lib/craps/CrapsGame';
	import { getCrapsAdvice } from '../../lib/craps/llmCrapsStrategy';
	import { BET_LABELS } from '../../lib/craps/constants';
	import type { BetType, RollResult, CrapsBet, CrapsGameState } from '../../lib/craps/types';
	import { loadAiSettings } from '../../lib/ai';
	import { initAchievementToast } from '../../lib/achievement-toast';
	import {
		isGuestModeValue,
		loadGuestBankroll,
		persistGuestBankroll,
		shouldSyncAccountChips,
	} from '../../lib/public-game-session';
	import { createSettlementGate, newSettlementId, type SettleRoundResult } from '../../lib/wallet';

	type PersistedCrapsSession = {
		gameState: Partial<CrapsGameState>;
		selectedChipAmount?: number;
	};

	// ─── Initialisation ─────────────────────────────────────────────────────────
	if (typeof window !== 'undefined') {
		const root = document.getElementById('craps-root');
		if (!root) throw new Error('craps-root not found');
		const initialBalance = Number(root.dataset.initialBalance ?? 1000);
		const userId = root.dataset.userId ?? 'anonymous';
		const isGuestMode = isGuestModeValue(root.dataset.guestMode);
		const persistedSessionKey = `craps-session:${userId}`;
		const guestBankrollGameKey = 'craps';

		// For guest sessions, restore the bankroll from the shared per-user
		// key (consistent with blackjack/baccarat/poker). If a persisted
		// session exists, restoreSession() below overrides the balance with
		// the session's value — which is authoritative because it is
		// consistent with any active bets restored alongside it.
		const restoredGuestBalance = isGuestMode
			? loadGuestBankroll(guestBankrollGameKey, userId, initialBalance)
			: initialBalance;

		const game = new CrapsGame({
			initialBalance: restoredGuestBalance,
			settings: { minBet: 5, maxBet: 500, maxOddsMultiplier: 2 },
		});

		// Persist the guest bankroll to the shared per-user key whenever the
		// session is persisted, so the balance survives a refresh even if the
		// session snapshot is cleared. No-op for authenticated sessions.
		const persistGuestBalance = () => {
			if (isGuestMode) {
				persistGuestBankroll(guestBankrollGameKey, userId, game.getBalance());
			}
		};

		let selectedChipAmount = 25;
		let serverSyncedBalance = initialBalance;
		const settlementGate = createSettlementGate();
		let diceAnimationTimeoutId: ReturnType<typeof setTimeout> | null = null;
		function getMaxOddsMultiplier(): number {
			return game.getState().settings.maxOddsMultiplier;
		}

		// ─── DOM helpers ─────────────────────────────────────────────────────────────

		function el<T extends HTMLElement>(id: string): T {
			const e = document.getElementById(id);
			if (!e) throw new Error(`#${id} not found`);
			return e as T;
		}

		const balanceEl = el('chip-balance');
		const totalBetEl = el('total-bet');
		const rollButton = el<HTMLButtonElement>('roll-button');
		const clearBetsBtn = el('clear-bets-button');
		const gameMessageEl = el('game-message');
		const phaseBadge = el('phase-badge');
		const pointBadge = el('point-badge');
		const oddsRow = el('odds-row');
		const rollTotalEl = el('roll-total');
		const rollHistoryEl = el<HTMLElement>('roll-history');
		const activeBetsEl = el('active-bets');
		const insufOverlay = el('insufficient-overlay');
		const llmAdviceEl = el('llm-advice');
		const llmAdviceBtn = el<HTMLButtonElement>('llm-advice-btn');
		const comeOddsPanel = el('come-odds-panel');
		const comeOddsListEl = el('come-odds-list');
		const settlementRecovery = el('settlement-recovery');
		const retrySettlementBtn = el<HTMLButtonElement>('btn-retry-settlement');
		const resetSettlementBtn = el<HTMLButtonElement>('btn-reset-settlement');

		// Set when a settlement commits server-side but adoptSettlementResult fails
		// locally. The roll button stays disabled and retry falls through to reset
		// until the user explicitly resets (re-syncing the authoritative balance).
		let settlementBlocked = false;

		function persistSession() {
			const state = game.getState();
			const isEmpty =
				state.activeBets.length === 0 && state.phase === 'come-out' && state.point === null;
			if (isEmpty) {
				localStorage.removeItem(persistedSessionKey);
				persistGuestBalance();
				return;
			}
			if (!isGuestMode) {
				// Authenticated users rely on the server-authoritative wallet balance
				// rendered into the page. Persisting local table state would let a
				// committed-but-unadopted settlement resurface after a refresh and be
				// rolled/settled a second time under a new settlement id. Guests have
				// no server to reconcile against, so their full state is persisted.
				persistGuestBalance();
				return;
			}
			const payload: PersistedCrapsSession = {
				gameState: state,
				selectedChipAmount,
			};
			try {
				localStorage.setItem(persistedSessionKey, JSON.stringify(payload));
			} catch (err) {
				console.error('[CRAPS] Failed to persist session to localStorage:', err);
			}
			persistGuestBalance();
		}

		function showSettlementRecovery(message: string) {
			showMessage(message, 'error');
			settlementRecovery.classList.remove('hidden');
			updateUI({ persist: false });
		}

		function hideSettlementRecovery() {
			settlementRecovery.classList.add('hidden');
		}

		function adoptSettlementResult(result: SettleRoundResult) {
			serverSyncedBalance = result.balance;
			const availableBalance = getAvailableCrapsBalance(result.balance, game.getTotalAtRisk());
			if (!game.setBalance(availableBalance)) {
				throw new Error('Wallet returned an invalid Craps balance');
			}
			// Persist only after the authoritative wallet balance has been adopted.
			// A failed pending command must leave the last durable game snapshot intact.
			persistSession();
			hideSettlementRecovery();
			settlementBlocked = false;
			if (result.newAchievements?.length) {
				window.dispatchEvent(
					new CustomEvent('achievement-earned', {
						detail: { achievements: result.newAchievements },
					}),
				);
			}
			updateUI({ persist: false });
		}

		async function fetchServerBalance(): Promise<number | null> {
			try {
				const response = await fetch('/api/chips/balance');
				if (!response.ok) return null;
				const data = (await response.json()) as { balance?: unknown };
				return typeof data.balance === 'number' && Number.isFinite(data.balance)
					? data.balance
					: null;
			} catch {
				return null;
			}
		}

		async function settleAuthenticatedRoll(
			command: ReturnType<typeof buildCrapsSettlementCommand>,
		) {
			if (!command) return;
			let result: SettleRoundResult;
			try {
				result = await settlementGate.settle(command);
			} catch (error) {
				console.error('[WALLET_SETTLEMENT] Craps settlement failed:', error);
				showSettlementRecovery('Settlement failed. Retry or reset before rolling again.');
				return;
			}
			// Settlement committed server-side; adopting locally can still fail.
			// Block further rolls until the user explicitly resets to re-sync.
			try {
				adoptSettlementResult(result);
			} catch (error) {
				settlementBlocked = true;
				console.error('[WALLET_SETTLEMENT] Craps adoption failed after settlement:', error);
				showSettlementRecovery(
					'Settlement committed but local balance could not be applied. Reset to sync your balance.',
				);
			}
		}

		retrySettlementBtn.addEventListener('click', async () => {
			if (!settlementGate.pending) {
				// Settlement committed but local adoption failed — no command to retry.
				// Fall through to the reset path to re-sync the authoritative balance.
				if (settlementBlocked) resetSettlementBtn.click();
				return;
			}
			retrySettlementBtn.disabled = true;
			showMessage('Retrying settlement...', 'info');
			try {
				const result = await settlementGate.retry();
				if (result) adoptSettlementResult(result);
			} catch (error) {
				console.error('[WALLET_SETTLEMENT] Craps settlement retry failed:', error);
				showSettlementRecovery('Settlement failed again. Retry or reset before rolling again.');
			} finally {
				retrySettlementBtn.disabled = false;
				updateUI({ persist: false });
			}
		});

		resetSettlementBtn.addEventListener('click', async () => {
			resetSettlementBtn.disabled = true;
			try {
				// Refresh the authoritative balance before resetting local state so
				// reset does not silently discard a committed-but-unadopted round.
				const serverBalance = await fetchServerBalance();
				if (serverBalance !== null) serverSyncedBalance = serverBalance;
			} catch {
				// Balance refresh is best-effort; fall back to last known balance.
			}
			settlementGate.reset();
			settlementBlocked = false;
			// Discard the partially settled table and re-sync to the authoritative
			// balance. Preserving local wagers/phase after a failed settlement can
			// silently refund a resolved loss while its roll/phase transition remains
			// in effect, because the resolved bets are no longer counted as at-risk.
			game.reset(serverSyncedBalance);
			hideSettlementRecovery();
			updateUI();
			showMessage('Settlement reset. Place your bets, then roll.');
			resetSettlementBtn.disabled = false;
		});

		function restoreSession() {
			if (!isGuestMode) {
				// Authenticated sessions start from the server-rendered wallet balance.
				// Any locally persisted table state is discarded to prevent a
				// committed-but-unadopted settlement from being re-rolled and settled
				// a second time after a refresh. Guests have no server to reconcile
				// against, so their full state is restored from localStorage.
				try {
					localStorage.removeItem(persistedSessionKey);
				} catch (err) {
					console.error('[CRAPS] Failed to clear stale session on restore:', err);
				}
				return;
			}
			let raw: string | null;
			try {
				raw = localStorage.getItem(persistedSessionKey);
			} catch (err) {
				console.error('[CRAPS] Failed to access localStorage for session restore:', err);
				return;
			}
			if (!raw) return;
			try {
				const parsed = JSON.parse(raw) as Partial<PersistedCrapsSession>;
				if (!parsed.gameState || !game.restoreState(parsed.gameState)) {
					localStorage.removeItem(persistedSessionKey);
					return;
				}
				if (
					typeof parsed.selectedChipAmount === 'number' &&
					[5, 25, 50, 100, 500].includes(parsed.selectedChipAmount)
				) {
					selectedChipAmount = parsed.selectedChipAmount;
				}
			} catch (err) {
				console.error('[CRAPS] Failed to restore session, clearing corrupted data:', err);
				localStorage.removeItem(persistedSessionKey);
			}
		}

		function setSelectedChip(amount: number) {
			selectedChipAmount = amount;
			document.querySelectorAll('.chip-select').forEach((btn) => btn.classList.remove('selected'));
			document.querySelector(`.chip-select[data-amount="${amount}"]`)?.classList.add('selected');
		}

		restoreSession();

		// Rehydrate UI after restoring session: render dice and roll history
		(function rehydrateUI() {
			const state = game.getState();

			// Render last roll dice if present
			if (state.lastRoll) {
				const d1Dots = document.getElementById('die1-dots');
				const d2Dots = document.getElementById('die2-dots');
				if (d1Dots) renderDie(d1Dots, state.lastRoll.die1);
				if (d2Dots) renderDie(d2Dots, state.lastRoll.die2);
				rollTotalEl.textContent = String(state.lastRoll.total);
			}

			// Rebuild roll history from stored history
			if (state.rollHistory.length > 0) {
				// Remove placeholder
				const placeholder = rollHistoryEl.querySelector('.roll-history-placeholder');
				if (placeholder) placeholder.remove();

				// Determine phase for each roll to apply correct styling
				// We need to replay through history to know which phase each roll was in
				let currentPhase: 'come-out' | 'point' = 'come-out';
				let currentPoint: number | null = null;

				// Build history entries (oldest first for replay logic)
				const historyEntries = [...state.rollHistory].reverse();

				historyEntries.forEach((roll) => {
					const total = roll.die1 + roll.die2;
					const prevPhase = currentPhase;

					// Replay the phase transition
					if (currentPhase === 'come-out') {
						if (total === 7 || total === 11) {
							// Natural: stay in come-out
						} else if (total === 2 || total === 3 || total === 12) {
							// Craps: stay in come-out
						} else {
							// Point established
							currentPhase = 'point';
							currentPoint = total;
						}
					} else {
						// Point phase
						if (total === 7) {
							// Seven-out: back to come-out
							currentPhase = 'come-out';
							currentPoint = null;
						} else if (total === currentPoint) {
							// Point hit: back to come-out
							currentPhase = 'come-out';
							currentPoint = null;
						}
					}

					addRollToHistory(total, prevPhase);
				});
			}
		})();

		function initializeInteractiveBetZones() {
			document.querySelectorAll('.bet-zone[data-bet-type]').forEach((el) => {
				const zone = el as HTMLElement;
				const type = zone.dataset.betType as BetType | undefined;
				if (!type) return;
				zone.dataset.testid = `bet-${type}`;
				zone.setAttribute('role', 'button');
				zone.tabIndex = 0;
				zone.setAttribute('aria-label', `Place ${BET_LABELS[type] ?? type} bet`);
			});

			document.querySelectorAll('.number-box').forEach((el) => {
				const box = el as HTMLElement;
				const n = box.dataset.number;
				if (n) box.setAttribute('aria-label', `Number ${n} betting box`);
			});

			[4, 5, 6, 8, 9, 10].forEach((n) => {
				const comeDisplay = document.getElementById(`come-${n}`);
				if (comeDisplay) comeDisplay.setAttribute('aria-label', `Come bets on ${n}`);
			});
		}

		// ─── Die face SVG dots ────────────────────────────────────────────────────────

		// cx,cy pairs for dot positions on a 60×60 die
		const DOT_POSITIONS: Record<number, [number, number][]> = {
			1: [[30, 30]],
			2: [
				[18, 18],
				[42, 42],
			],
			3: [
				[18, 18],
				[30, 30],
				[42, 42],
			],
			4: [
				[18, 18],
				[42, 18],
				[18, 42],
				[42, 42],
			],
			5: [
				[18, 18],
				[42, 18],
				[30, 30],
				[18, 42],
				[42, 42],
			],
			6: [
				[18, 15],
				[42, 15],
				[18, 30],
				[42, 30],
				[18, 45],
				[42, 45],
			],
		};

		function renderDie(dotsEl: Element, value: number) {
			dotsEl.innerHTML = '';
			const positions = DOT_POSITIONS[value] ?? [];
			for (const [cx, cy] of positions) {
				const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
				circle.setAttribute('cx', String(cx));
				circle.setAttribute('cy', String(cy));
				circle.setAttribute('r', '5');
				circle.setAttribute('class', 'die-dot');
				dotsEl.appendChild(circle);
			}
		}

		function animateDice(die1: number, die2: number) {
			const d1 = document.getElementById('die1');
			const d2 = document.getElementById('die2');
			[d1, d2].forEach((d) => d?.classList.add('die-rolling'));
			if (diceAnimationTimeoutId) {
				clearTimeout(diceAnimationTimeoutId);
			}
			diceAnimationTimeoutId = setTimeout(() => {
				[d1, d2].forEach((d) => d?.classList.remove('die-rolling'));
				const d1Dots = document.getElementById('die1-dots');
				const d2Dots = document.getElementById('die2-dots');
				if (d1Dots) renderDie(d1Dots, die1);
				if (d2Dots) renderDie(d2Dots, die2);
				rollTotalEl.textContent = String(die1 + die2);
				diceAnimationTimeoutId = null;
			}, 420);
		}

		// ─── UI update ───────────────────────────────────────────────────────────────

		function updateUI({ persist = true }: { persist?: boolean } = {}) {
			const state = game.getState();

			// Balance
			balanceEl.textContent = `$${state.chipBalance.toLocaleString()}`;

			// Total bet
			const total = game.getTotalAtRisk();
			totalBetEl.textContent = `$${total}`;

			// An authenticated roll cannot start while its previous resolved wagers
			// still need wallet settlement. Guests remain local-only and are never gated.
			rollButton.disabled =
				!game.canRoll() ||
				(shouldSyncAccountChips({ isGuestMode }) &&
					(settlementGate.isBlocked || settlementBlocked));

			// Phase badge
			if (state.phase === 'come-out') {
				phaseBadge.textContent = 'Come-Out';
				phaseBadge.className =
					'px-2 py-0.5 rounded text-xs font-bold bg-[var(--deco-obsidian-3)] text-[var(--deco-sapphire)] uppercase tracking-wider';
				pointBadge.classList.add('hidden');
				oddsRow.classList.add('hidden');
				oddsRow.style.removeProperty('display');
			} else {
				phaseBadge.textContent = 'Point Phase';
				phaseBadge.className =
					'px-2 py-0.5 rounded text-xs font-bold bg-[var(--deco-obsidian-3)] text-[var(--deco-brass)] uppercase tracking-wider';
				pointBadge.textContent = `Point: ${state.point}`;
				pointBadge.classList.remove('hidden');
				oddsRow.classList.remove('hidden');
				oddsRow.style.display = 'grid';
			}

			// Highlight the point number box
			document.querySelectorAll('.number-box').forEach((box) => {
				const n = Number((box as HTMLElement).dataset.number);
				box.classList.toggle('number-box-point', state.phase === 'point' && n === state.point);
			});

			// Bet zone amounts
			document.querySelectorAll('[data-bet-type]').forEach((zone) => {
				const type = (zone as HTMLElement).dataset.betType as BetType;
				const amountEl = zone.querySelector('.bet-amount');
				if (!amountEl) return;

				// For passLineOdds/dontPassOdds, show the odds on the line bet
				if (type === 'passLineOdds') {
					const lineBet = state.activeBets.find((b) => b.type === 'passLine');
					const odds = lineBet?.odds ?? 0;
					amountEl.textContent = odds > 0 ? `$${odds}` : '';
				} else if (type === 'dontPassOdds') {
					const lineBet = state.activeBets.find((b) => b.type === 'dontPass');
					const odds = lineBet?.odds ?? 0;
					amountEl.textContent = odds > 0 ? `$${odds}` : '';
				} else {
					const bets = state.activeBets.filter((b) => b.type === type && !b.point);
					const totalAmount = bets.reduce((sum, b) => sum + b.amount, 0);
					amountEl.textContent = totalAmount > 0 ? `$${totalAmount}` : '';
				}

				// Active glow
				const hasBet =
					type === 'passLineOdds'
						? (state.activeBets.find((b) => b.type === 'passLine')?.odds ?? 0) > 0
						: type === 'dontPassOdds'
							? (state.activeBets.find((b) => b.type === 'dontPass')?.odds ?? 0) > 0
							: state.activeBets.some((b) => b.type === type && !b.point);
				zone.classList.toggle('bet-zone-active', hasBet);
			});

			// Phase-based bet zone restrictions
			applyPhaseRestrictions(state.phase);
			document.querySelectorAll('.bet-zone').forEach((el) => {
				const zone = el as HTMLElement;
				const disabled =
					zone.classList.contains('bet-zone-disabled') ||
					zone.classList.contains('bet-zone-locked');
				zone.setAttribute('aria-disabled', String(disabled));
				// Remove disabled/locked bet zones from tab order for accessibility
				zone.tabIndex = disabled ? -1 : 0;
			});

			// Come bets on number boxes
			[4, 5, 6, 8, 9, 10].forEach((n) => {
				const container = document.getElementById(`come-${n}`);
				if (!container) return;
				const comeBets = state.activeBets.filter(
					(b) => (b.type === 'come' || b.type === 'dontCome') && b.point === n,
				);
				if (comeBets.length > 0) {
					container.classList.remove('hidden');
					const totalAmount = comeBets.reduce((s, b) => s + b.amount + (b.odds ?? 0), 0);
					const amtEl = container.querySelector('.come-display-amount');
					if (amtEl) amtEl.textContent = `$${totalAmount}`;
				} else {
					container.classList.add('hidden');
				}
			});

			// Come odds panel
			const establishedComeBets = state.activeBets.filter(
				(b) => (b.type === 'come' || b.type === 'dontCome') && b.point,
			);
			if (establishedComeBets.length > 0) {
				comeOddsPanel.classList.remove('hidden');
				renderComeOddsButtons(establishedComeBets);
			} else {
				comeOddsPanel.classList.add('hidden');
				comeOddsListEl.innerHTML = '';
			}

			// Active bets list
			renderActiveBets(state.activeBets);
			if (persist) persistSession();
		}

		function applyPhaseRestrictions(phase: 'come-out' | 'point') {
			// Come/DontCome only during point phase
			['come', 'dontCome'].forEach((t) => {
				document
					.querySelector(`[data-bet-type="${t}"]`)
					?.classList.toggle('bet-zone-disabled', phase !== 'point');
			});
			// PassLine/DontPass only during come-out
			['passLine', 'dontPass'].forEach((t) => {
				const alreadyBet = game.getState().activeBets.some((b) => b.type === t);
				const zone = document.querySelector(`[data-bet-type="${t}"]`);
				if (!zone) return;
				if (alreadyBet && phase === 'point') {
					zone.classList.add('bet-zone-locked');
					zone.classList.remove('bet-zone-disabled');
				} else if (phase === 'point' && !alreadyBet) {
					zone.classList.add('bet-zone-disabled');
				} else {
					zone.classList.remove('bet-zone-locked', 'bet-zone-disabled');
				}
			});
		}

		function renderActiveBets(bets: CrapsBet[]) {
			if (bets.length === 0) {
				activeBetsEl.innerHTML =
					'<span class="text-[var(--deco-muted)] text-xs">No bets placed</span>';
				return;
			}
			activeBetsEl.innerHTML = '';
			for (const bet of bets) {
				const label = BET_LABELS[bet.type] ?? bet.type;
				const pointStr = bet.point ? ` @${bet.point}` : '';
				const oddsStr = bet.odds ? ` +odds:$${bet.odds}` : '';

				const row = document.createElement('div');
				row.className = 'flex items-center justify-between text-xs';
				const labelSpan = document.createElement('span');
				labelSpan.className = 'text-[var(--deco-ivory-dim)]';
				labelSpan.textContent = `${label}${pointStr}`;
				const amountSpan = document.createElement('span');
				amountSpan.className = 'text-[var(--deco-brass)] font-bold';
				amountSpan.textContent = `$${bet.amount}${oddsStr}`;
				row.appendChild(labelSpan);
				row.appendChild(amountSpan);
				activeBetsEl.appendChild(row);
			}
		}

		function getComeOddsAmount(bet: CrapsBet): number {
			const currentOdds = bet.odds ?? 0;
			const remaining = bet.amount * getMaxOddsMultiplier() - currentOdds;
			return remaining > 0 ? Math.min(selectedChipAmount, remaining) : 0;
		}

		function renderComeOddsButtons(bets: CrapsBet[]) {
			comeOddsListEl.innerHTML = '';
			for (const bet of bets) {
				const label = `${bet.type === 'come' ? 'Come' : "Don't Come"} @${bet.point}`;
				const maxOdds = bet.amount * getMaxOddsMultiplier();
				const currentOdds = bet.odds ?? 0;
				const remaining = maxOdds - currentOdds;
				const oddsAmount = getComeOddsAmount(bet);
				if (remaining <= 0) continue;

				const row = document.createElement('div');
				row.className = 'flex items-center justify-between gap-2';
				const labelSpan = document.createElement('span');
				labelSpan.className = 'text-[var(--deco-ivory-dim)] text-xs flex-1';
				labelSpan.textContent = `${label} ($${currentOdds}/$${maxOdds})`;
				const button = document.createElement('button');
				button.className =
					'add-come-odds px-2 py-1 text-xs bg-[var(--deco-emerald-deep)] hover:bg-[var(--deco-emerald)] text-[var(--deco-jade)] border border-[var(--deco-emerald-line)] rounded';
				button.dataset.betId = String(bet.id);
				button.textContent = `+$${oddsAmount}`;
				row.appendChild(labelSpan);
				row.appendChild(button);
				comeOddsListEl.appendChild(row);
			}

			comeOddsListEl.querySelectorAll('.add-come-odds').forEach((btn) => {
				btn.addEventListener('click', () => {
					const betId = (btn as HTMLElement).dataset.betId!;
					const currentBet = game.getState().activeBets.find((bet) => bet.id === betId);
					if (!currentBet) {
						showMessage('Bet not found', 'error');
						updateUI();
						return;
					}
					const amount = getComeOddsAmount(currentBet);
					if (amount < 1) {
						showMessage('Cannot add odds', 'error');
						updateUI();
						return;
					}
					const r = game.addComeBetOdds(betId, amount);
					if (!r.success) {
						showMessage(r.error ?? 'Cannot add odds', 'error');
						updateUI();
						return;
					}
					updateUI();
				});
			});
		}

		// ─── Roll history ─────────────────────────────────────────────────────────────

		function addRollToHistory(total: number, prevPhase: 'come-out' | 'point') {
			// Remove "no rolls" placeholder
			const placeholder = rollHistoryEl.querySelector('.roll-history-placeholder');
			if (placeholder) placeholder.remove();

			const badge = document.createElement('span');
			badge.className = 'roll-badge';
			badge.textContent = String(total);

			if (prevPhase === 'come-out') {
				if (total === 7 || total === 11) badge.className += ' roll-natural';
				else if (total === 2 || total === 3 || total === 12) badge.className += ' roll-craps';
				else badge.className += ' roll-point';
			} else {
				if (total === 7) badge.className += ' roll-seven';
				else badge.className += ' roll-normal';
			}

			rollHistoryEl.insertBefore(badge, rollHistoryEl.firstChild);

			// Keep last 15 badges
			const badges = rollHistoryEl.querySelectorAll('.roll-badge');
			if (badges.length > 15) badges[badges.length - 1].remove();
		}

		// ─── Roll result display ─────────────────────────────────────────────────────

		function showRollResult(result: RollResult) {
			// Show outcome in message area based on player's actual result (netDelta)
			let msgClass = 'text-[var(--deco-ivory-dim)]';
			if (result.netDelta > 0) {
				msgClass = 'text-[var(--deco-jade)]';
			} else if (result.netDelta < 0) {
				msgClass = 'text-[var(--deco-oxblood-bright)]';
			}
			gameMessageEl.className = `text-sm font-semibold ${msgClass}`;
			gameMessageEl.textContent = result.message;

			// Show net delta
			if (result.netDelta !== 0) {
				const sign = result.netDelta > 0 ? '+' : '';
				const deltaEl = document.createElement('span');
				deltaEl.className = `ml-2 text-xs ${result.netDelta > 0 ? 'text-[var(--deco-jade)]' : 'text-[var(--deco-oxblood-bright)]'}`;
				deltaEl.textContent = `(${sign}$${result.netDelta})`;
				gameMessageEl.appendChild(deltaEl);
			}
		}

		function showMessage(msg: string, type: 'info' | 'error' = 'info') {
			gameMessageEl.className = `text-sm ${type === 'error' ? 'text-[var(--deco-oxblood-bright)]' : 'text-[var(--deco-ivory-dim)]'}`;
			gameMessageEl.textContent = msg;
		}

		// ─── Event listeners ─────────────────────────────────────────────────────────

		// Chip selection
		document.querySelectorAll('.chip-select').forEach((btn) => {
			btn.addEventListener('click', () => {
				setSelectedChip(Number((btn as HTMLElement).dataset.amount));
				updateUI();
			});
		});
		setSelectedChip(selectedChipAmount);

		function placeBetFromZone(zone: HTMLElement) {
			if (
				zone.classList.contains('bet-zone-disabled') ||
				zone.classList.contains('bet-zone-locked')
			) {
				return;
			}
			const type = zone.dataset.betType as BetType;
			const r = game.placeBet(type, selectedChipAmount);
			if (r.success) {
				updateUI();
			} else {
				showMessage(r.error ?? 'Cannot place bet', 'error');
			}
		}

		// Bet zone clicks + keyboard activation
		document.querySelectorAll('[data-bet-type]').forEach((zone) => {
			if (!(zone instanceof HTMLElement)) return;
			zone.addEventListener('click', () => {
				placeBetFromZone(zone);
			});
			zone.addEventListener('keydown', (event) => {
				if (event.key === 'Enter' || event.key === ' ') {
					event.preventDefault();
					placeBetFromZone(zone);
				}
			});
		});

		// Roll button
		rollButton.addEventListener('click', async () => {
			if (
				shouldSyncAccountChips({ isGuestMode }) &&
				(settlementGate.isBlocked || settlementBlocked)
			) {
				showSettlementRecovery('Settlement is still pending. Retry or reset before rolling again.');
				return;
			}
			rollButton.disabled = true;
			try {
				const prevPhase = game.getState().phase;

				// Animate dice first
				const tempDie1 = Math.ceil(Math.random() * 6);
				const tempDie2 = Math.ceil(Math.random() * 6);
				animateDice(tempDie1, tempDie2);

				await new Promise((r) => setTimeout(r, 200));

				const result = game.roll();
				if (!result) {
					return;
				}

				// Update dice display with real values
				if (diceAnimationTimeoutId) {
					clearTimeout(diceAnimationTimeoutId);
					diceAnimationTimeoutId = null;
				}
				document.getElementById('die1')?.classList.remove('die-rolling');
				document.getElementById('die2')?.classList.remove('die-rolling');
				const d1Dots = document.getElementById('die1-dots');
				const d2Dots = document.getElementById('die2-dots');
				if (d1Dots) renderDie(d1Dots, result.roll.die1);
				if (d2Dots) renderDie(d2Dots, result.roll.die2);
				rollTotalEl.textContent = String(result.roll.total);

				showRollResult(result);
				addRollToHistory(result.roll.total, prevPhase);
				// Keep the resolved roll out of durable session state until its wallet
				// settlement succeeds. Guests and unresolved rolls persist below.
				updateUI({ persist: false });

				const command = buildCrapsSettlementCommand(newSettlementId('craps'), result);
				if (command && shouldSyncAccountChips({ isGuestMode })) {
					await settleAuthenticatedRoll(command);
				} else {
					persistSession();
				}

				if (game.hasInsufficientChips()) {
					insufOverlay.classList.remove('hidden');
					insufOverlay.classList.add('flex');
				}
			} catch (err) {
				console.error('[CRAPS] Unexpected error in roll handler:', err);
				showMessage('An unexpected error occurred. Please try again.', 'error');
			} finally {
				updateUI({ persist: false });
			}
		});

		// Clear bets
		clearBetsBtn.addEventListener('click', () => {
			game.clearBets();
			updateUI();
		});

		// LLM Advisor
		llmAdviceBtn.addEventListener('click', async () => {
			if (isGuestMode) {
				llmAdviceEl.textContent =
					'Sign in and configure an AI provider in Profile to use provider advice.';
				return;
			}

			const settings = loadAiSettings();
			if (!settings) {
				llmAdviceEl.textContent = 'Configure an AI provider in Profile to use advice.';
				return;
			}

			llmAdviceBtn.disabled = true;
			llmAdviceBtn.textContent = '...';
			llmAdviceEl.textContent = 'Thinking...';

			try {
				const state = game.getState();
				const result = await getCrapsAdvice(
					{
						phase: state.phase,
						point: state.point,
						activeBets: state.activeBets,
						rollHistory: state.rollHistory,
						chipBalance: state.chipBalance,
					},
					settings,
				);

				if (!result.ok) {
					llmAdviceEl.textContent =
						result.status === 401
							? 'Invalid API key. Update your AI settings in Profile.'
							: result.status === 429
								? 'AI provider rate limit reached. Please wait a moment.'
								: 'AI advice is unavailable. You can keep playing normally.';
					return;
				}

				llmAdviceEl.textContent = result.value.advice;
			} catch (e) {
				console.error('[CRAPS] Failed to load LLM advice:', e);
				llmAdviceEl.textContent = 'Could not load advice. Please try again.';
			} finally {
				llmAdviceBtn.disabled = false;
				llmAdviceBtn.textContent = 'Ask';
			}
		});

		// ─── Achievement toast ───────────────────────────────────────────────────────

		const achievementToast = document.getElementById('achievement-toast');
		const achievementIconEl = document.getElementById('achievement-icon');
		const achievementNameEl = document.getElementById('achievement-name');

		if (achievementToast && achievementIconEl && achievementNameEl) {
			const { enqueue } = initAchievementToast(() => ({
				toast: achievementToast,
				icon: achievementIconEl,
				name: achievementNameEl,
			}));

			window.addEventListener('achievement-earned', (event: Event) => {
				const { achievements } = (
					event as CustomEvent<{ achievements: Array<{ id: string; name: string; icon: string }> }>
				).detail;
				// Validate achievements is an array before calling enqueue
				if (Array.isArray(achievements)) {
					enqueue(achievements);
				}
			});
		}

		// ─── Initial render ───────────────────────────────────────────────────────────

		initializeInteractiveBetZones();
		updateUI();
	}
</script>
