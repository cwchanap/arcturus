{
	"name": "arcturus",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/logs bun scripts/apply-migrations.ts",
		"db:migrate:remote": "WRANGLER_LOG_PATH=.wrangler/logs bun scripts/apply-migrations.ts --remote",
		"db:studio": "drizzle-kit studio",
		"setup:db": "bun scripts/setup-local-db.ts",
		"deploy": "astro build && wrangler deploy",
		"prepare": "husky",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun test src/ && vitest run",
		"test:unit": "bun test src/",
		"test:integration": "vitest run",
		"test:coverage": "bun test src/ --coverage --coverage-reporter=text --coverage-reporter=lcov",
		"test:e2e": "playwright test",
		"test:e2e:ci": "bun run db:migrate:local && playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:report": "playwright show-report",
		"test:e2e:mp": "bun run db:migrate:local && MP_E2E=1 bunx playwright test e2e/multiplayer-poker.spec.ts --config playwright.config.mp.ts"
	},
	"lint-staged": {
		"*.{js,mjs,ts,tsx,astro}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@astrojs/mdx": "^4.3.6",
		"@libsql/client": "^0.18.0",
		"@noble/hashes": "^2.4.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/canvas-confetti": "^1.9.0",
		"astro": "^5.14.1",
		"better-auth": "^1.7.7",
		"better-call": "^1.4.1",
		"better-sqlite3": "^12.4.1",
		"canvas-confetti": "^1.9.4",
		"drizzle-orm": "^0.45.3",
		"tailwindcss": "^4.3.3",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@astrojs/cloudflare": "^12.6.10",
		"@cloudflare/workers-types": "^4.20250927.0",
		"@eslint/js": "^9.36.0",
		"@fontsource/jost": "^5.3.0",
		"@fontsource/playfair-display": "^5.3.0",
		"@playwright/test": "^1.63.0",
		"@types/bun": "^1.4.2",
		"drizzle-kit": "^0.31.11",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^1.3.1",
		"happy-dom": "20.14.5",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.3",
		"miniflare": "4.20260730.0",
		"prettier": "^3.9.9",
		"prettier-plugin-astro": "^0.14.1",
		"typescript-eslint": "^8.71.0",
		"vitest": "^3.2.4",
		"wrangler": "^4.147.0"
	}
}
