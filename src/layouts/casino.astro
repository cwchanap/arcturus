---
import AppLayout from './AppLayout.astro';
import AchievementToast from '../components/AchievementToast.astro';

interface Props {
	title?: string;
	headerSticky?: boolean;
	bodyClass?: string;
	footerClass?: string;
}

const { title = 'Arcturus Casino', headerSticky, bodyClass, footerClass } = Astro.props as Props;
---

<AppLayout
	title={title}
	headerSticky={headerSticky}
	bodyClass={bodyClass}
	footerClass={footerClass}
>
	<slot />
	<!-- Shared achievement toast: every casino page gets the listener and
	     markup, so badges granted on any settled round render feedback. -->
	<AchievementToast />
</AppLayout>
