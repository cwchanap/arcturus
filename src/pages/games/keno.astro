---
import CabinetDrawer from '../../components/CabinetDrawer.astro';
import TableCabinetHeader from '../../components/TableCabinetHeader.astro';
import DecoIcon from '../../components/DecoIcon.astro';
import { cabinetTranslator } from '../../lib/i18n/messages/cabinet';
import '../../styles/table-cabinet.css';
import '../../styles/keno.css';
import CasinoLayout from '../../layouts/casino.astro';
import { createPublicGameSession } from '../../lib/public-game-session';
import { BET_INCREMENTS } from '../../lib/keno/constants';
import { formatChips, getBalanceLabel } from '../../lib/i18n/messages/common';
import { getGameName } from '../../lib/i18n/messages/games';
import { kenoTranslator } from '../../lib/i18n/messages/keno';

const user = Astro.locals.user;
const gameSession = createPublicGameSession(user);
const initialBalance = gameSession.initialBalance;
const locale = Astro.locals.locale;
const t = kenoTranslator(locale);
const clientUserId = gameSession.clientUserId;
const cabinet = cabinetTranslator(locale);
---

<CasinoLayout title={t('pageTitle', { game: getGameName(locale, 'keno') })} footerClass="hidden">
	<div
		id="keno-root"
		data-testid="keno-root"
		data-user-id={clientUserId}
		data-guest-mode={gameSession.guestModeValue}
		data-initial-balance={initialBalance}
		class="table-cabinet keno-cabinet"
	>
		<div class="tc-interior">
			<TableCabinetHeader
				title={getGameName(locale, 'keno')}
				backLabel={t('backToGames')}
				balance={formatChips(initialBalance, locale)}
				balanceLabel={getBalanceLabel(locale, gameSession.isGuest)}
				tag={cabinet('ballsDrawn')}
				icon="keno"
			>
				<span class="tc-top">{cabinet('top')} <strong>×50,000</strong></span>
				<button
					class="tc-icon"
					type="button"
					data-cabinet-panel="keno-history"
					aria-label={t('recentTickets')}
					title={t('recentTickets')}
					aria-haspopup="dialog"
					aria-expanded="false"><DecoIcon name="menu" /></button
				>
				<button
					type="button"
					id="btn-paytable"
					data-testid="btn-paytable"
					class="tc-icon"
					aria-label={t('paytableButton')}
					title={t('paytableButton')}
					aria-haspopup="dialog"
					aria-expanded="false">?</button
				>
				<button
					type="button"
					id="btn-settings"
					data-testid="btn-settings"
					class="tc-icon"
					aria-label={t('settingsButton')}
					title={t('settingsButton')}
					aria-haspopup="dialog"
					aria-expanded="false"
					><svg
						width="20"
						height="20"
						viewBox="0 0 24 24"
						fill="none"
						stroke="currentColor"
						stroke-width="1.5"
						aria-hidden="true"
						><path d="M4 6h16M4 12h16M4 18h16"></path><circle cx="8" cy="6" r="2" fill="#10241e"
						></circle><circle cx="16" cy="12" r="2" fill="#10241e"></circle><circle
							cx="10"
							cy="18"
							r="2"
							fill="#10241e"></circle></svg
					></button
				>
			</TableCabinetHeader>
			<div class="tc-content keno-content">
				<div class="keno-playfield">
					<div class="keno-board"><div id="keno-grid" data-testid="keno-grid"></div></div>
					<aside class="keno-results">
						<div data-testid="game-status" role="status" aria-live="polite" class="keno-status">
							{t('statusPickNumbers')}
						</div>
						<div class="keno-prize">
							<div class="tc-diamond">
								<strong data-keno-payout>—</strong><small>{cabinet('payout')}</small>
							</div>
						</div>
						<dl class="keno-metrics">
							<div>
								<dt>{t('spots')}</dt><dd id="spot-count" data-testid="spot-count">0/10</dd>
							</div><div><dt>{cabinet('caught')}</dt><dd data-keno-caught>—</dd></div><div>
								<dt>{cabinet('pays')}</dt><dd data-keno-multiplier>—</dd>
							</div>
						</dl>
						<div class="keno-last">
							<span class="tc-label">{cabinet('lastDraw')}</span><p
								data-testid="last-result"
								role="status"
								aria-live="polite"
							>
								{t('lastResultIdle')}
							</p>
						</div>
						<details class="keno-inline-paytable">
							<summary>{t('paytableCurrentSpots')}</summary><div
								id="paytable-body"
								data-testid="paytable-body"
							>
							</div>
						</details>
					</aside>
				</div>
				<div class="tc-divider" aria-hidden="true"><span>◆ ◇ ◆</span></div>
				<div class="tc-controls">
					<div class="tc-chips" id="bet-chips" data-testid="bet-chips">
						<span class="tc-label">{t('bet')}</span>{
							BET_INCREMENTS.map((amount, i) => (
								<button
									type="button"
									class="bet-chip tc-chip"
									data-bet={amount}
									aria-label={formatChips(amount, locale)}
									aria-pressed={i === 0 ? 'true' : 'false'}
								>
									{amount}
								</button>
							))
						}
					</div>
					<div class="tc-stake">
						<span>{t('bet')}</span><strong id="current-bet" data-testid="current-bet"
							>{formatChips(1, locale)}</strong
						>
					</div>
					<div class="keno-actions">
						<button type="button" id="btn-quickpick" data-testid="btn-quickpick" class="tc-button"
							>{t('quickPick')}</button
						>
						<button type="button" id="btn-clear" data-testid="btn-clear" class="tc-button"
							>{t('clear')}</button
						>
						<button type="button" id="btn-repeat" data-testid="btn-repeat" class="tc-button"
							>{t('repeat')}</button
						>
						<button
							type="button"
							id="btn-draw"
							data-testid="btn-draw"
							class="tc-button tc-primary"
							disabled>{t('draw')}</button
						>
					</div>
				</div>
				<div
					id="settlement-paused-banner"
					data-testid="settlement-paused-banner"
					class="hidden tc-status"
				>
					<p>{t('settlementAttention')}</p><button
						type="button"
						id="btn-retry-settlement"
						data-testid="btn-retry-settlement"
						class="tc-button">{t('retrySettlement')}</button
					>
				</div>
			</div>
			<CabinetDrawer id="keno-history" title={t('recentTickets')} closeLabel={cabinet('close')}
				><div id="recent-tickets" data-testid="recent-tickets"></div><p class="tc-empty">
					{cabinet('noHistory')}
				</p></CabinetDrawer
			>
		</div>
		<!-- Settings modal -->
		<div
			id="settings-modal"
			data-testid="settings-modal"
			class="keno-modal hidden fixed inset-0 z-50 flex bg-black/60"
			role="dialog"
			aria-modal="true"
			aria-labelledby="settings-title"
		>
			<div
				class="bg-[var(--deco-obsidian-2)] rounded-2xl border border-[var(--deco-brass-dim)] p-6 max-w-sm w-full mx-4"
			>
				<div class="flex items-center justify-between mb-4">
					<h2 id="settings-title" class="text-lg font-bold text-[var(--deco-brass)]">
						{t('settingsTitle')}
					</h2>
					<button
						type="button"
						id="btn-settings-close"
						data-testid="btn-settings-close"
						class="text-[var(--deco-muted)] hover:text-[var(--deco-brass)] text-xl"
						aria-label={t('closeSettings')}>&times;</button
					>
				</div>
				<div class="mb-2 text-sm text-[var(--deco-muted)]">{t('animationSpeed')}</div>
				<div class="flex gap-2" id="speed-options" data-testid="speed-options">
					<button
						type="button"
						class="speed-opt deco-btn flex-1 py-2 rounded-lg text-sm"
						data-speed="slow">{t('speedSlow')}</button
					>
					<button
						type="button"
						class="speed-opt deco-btn flex-1 py-2 rounded-lg text-sm"
						data-speed="normal">{t('speedNormal')}</button
					>
					<button
						type="button"
						class="speed-opt deco-btn flex-1 py-2 rounded-lg text-sm"
						data-speed="fast">{t('speedFast')}</button
					>
				</div>
			</div>
		</div>
		<!-- Paytable modal -->
		<div
			id="paytable-modal"
			data-testid="paytable-modal"
			class="keno-modal hidden fixed inset-0 z-50 flex bg-black/60"
			role="dialog"
			aria-modal="true"
			aria-labelledby="paytable-title"
		>
			<div
				class="bg-[var(--deco-obsidian-2)] rounded-2xl border border-[var(--deco-brass-dim)] p-6 max-w-md w-full mx-4"
			>
				<div class="flex items-center justify-between mb-4">
					<h2 id="paytable-title" class="text-lg font-bold text-[var(--deco-brass)]">
						{t('paytableTitle')}
					</h2>
					<button
						type="button"
						id="btn-paytable-close"
						data-testid="btn-paytable-close"
						class="text-[var(--deco-muted)] hover:text-[var(--deco-brass)] text-xl"
						aria-label={t('closePaytable')}>&times;</button
					>
				</div>
				<div
					id="paytable-modal-body"
					data-testid="paytable-modal-body"
					class="text-sm max-h-[60vh] overflow-y-auto"
				>
				</div>
			</div>
		</div>
		<div
			id="achievement-toast"
			data-testid="achievement-toast"
			class="hidden fixed bottom-6 right-6 z-50"
		>
		</div>
	</div>
</CasinoLayout>

<script>
	import { initKenoClient } from '../../lib/keno/kenoClient';
	initKenoClient();
</script>
