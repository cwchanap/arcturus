---
import CasinoLayout from '../../layouts/casino.astro';
import { getDailyWindow } from '../../lib/blackjack-run/daily';
import { hashUserId } from '../../lib/public-game-session';
import { dailyChallengeTranslator } from '../../lib/i18n/messages/daily-challenge';
import { getGameName } from '../../lib/i18n/messages/games';

// Guest access is an intentional exception for the Daily Challenge page: unauthenticated
// visitors can browse the current period, leaderboard, and play the browser-local practice
// scenario. Other game pages redirect to /signin, but this page serves a public, cacheable
// summary. The 'guest' surrogate user ID keeps data-user-id present on cached HTML so the
// client can distinguish guests from a missing attribute.
const user = Astro.locals.user;
const locale = Astro.locals.locale;
const t = dailyChallengeTranslator(locale);

if (user) {
	Astro.response.headers.set('Cache-Control', 'private, no-store');
} else {
	Astro.response.headers.set(
		'Cache-Control',
		'public, max-age=0, s-maxage=60, stale-while-revalidate=300',
	);
	// Automatic browser-language detection (Accept-Language) varies the cached
	// shell, so one CDN copy can never leak the wrong locale to another visitor.
	Astro.response.headers.set('Vary', 'Cookie, Accept-Language');
}

const currentWindow = getDailyWindow(Math.trunc(Date.now() / 1000));
const currentPeriod = currentWindow.periodKey;
const entryClosesAt = new Date(currentWindow.rankedEntryClosesAt * 1000)
	.toISOString()
	.slice(11, 16);
---

<CasinoLayout title={t('pageTitle')}>
	<main
		id="daily-challenge-root"
		data-user-id={user ? hashUserId(user.id) : 'guest'}
		data-period-key={currentPeriod}
		class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8"
	>
		<header class="mb-8 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
			<div>
				<a
					href="/games"
					class="mb-3 inline-block text-[var(--deco-muted)] transition-colors hover:text-[var(--deco-brass)]"
				>
					← {t('backToGames')}
				</a>
				<div class="flex flex-wrap items-center gap-3">
					<h1 class="deco-section-title text-4xl">{t('dailyChallenge')}</h1>
					<span
						class="rounded-full border border-[var(--deco-brass)] bg-[var(--deco-brass-dim)] px-3 py-1 text-xs font-bold uppercase tracking-[0.2em] text-[var(--deco-brass-bright)]"
					>
						{getGameName(locale, 'blackjack')}
					</span>
				</div>
				<p
					data-testid="daily-challenge-close"
					class="mt-3 max-w-2xl text-sm leading-6 text-[var(--deco-muted)]"
				>
					{t('rankedEntryCloses', { time: entryClosesAt })}
				</p>
			</div>
			<div
				class="grid grid-cols-2 gap-3 rounded-xl border border-[var(--deco-line)] bg-[var(--deco-obsidian-2)] p-4"
			>
				<div>
					<p class="text-xs uppercase tracking-wider text-[var(--deco-muted)]">
						{t('challengeDate')}
					</p>
					<p class="text-xl font-bold text-[var(--deco-ivory)]">{currentPeriod}</p>
				</div>
				<div>
					<p class="text-xs uppercase tracking-wider text-[var(--deco-muted)]">{t('reset')}</p>
					<p class="text-xl font-bold text-[var(--deco-ivory)]">{t('resetTime')}</p>
				</div>
			</div>
		</header>

		<div class="mb-6 flex flex-wrap items-center gap-3">
			<button
				type="button"
				data-testid="daily-challenge-mode-practice"
				class="deco-btn deco-btn-primary"
			>
				{t('practice')}
			</button>
			<button type="button" data-testid="daily-challenge-mode-ranked" class="deco-btn">
				{t('ranked')}
			</button>
			<a
				href="/signin"
				data-testid="daily-challenge-sign-in-cta"
				class="deco-btn deco-btn-outline"
				hidden
			>
				{t('signInToPlayRanked')}
			</a>
		</div>

		<div data-testid="daily-challenge-practice-notices" class="mb-6 space-y-2" hidden>
			<p
				data-testid="daily-challenge-practice-local"
				class="rounded-lg border border-[var(--deco-line)] bg-[var(--deco-obsidian-2)] px-4 py-2 text-sm text-[var(--deco-muted)]"
			>
				{t('practiceNotice')}
			</p>
		</div>

		<div data-testid="daily-challenge-ranked-notices" class="mb-6 space-y-2" hidden>
			<p
				data-testid="daily-challenge-once-warning"
				class="rounded-lg border border-[var(--deco-brass-dim)] bg-[var(--deco-obsidian-2)] px-4 py-2 text-sm text-[var(--deco-brass)]"
			>
				{t('onceWarning')}
			</p>
		</div>

		<section data-testid="daily-challenge-controls" hidden>
			<div
				class="mb-6 grid grid-cols-3 gap-3 rounded-xl border border-[var(--deco-line)] bg-[var(--deco-obsidian-2)] p-4"
			>
				<div>
					<p class="text-xs uppercase tracking-wider text-[var(--deco-muted)]">
						{t('bankroll')}
					</p>
					<p
						data-testid="daily-challenge-bankroll"
						class="text-2xl font-bold text-[var(--deco-brass)]"
					>
						—
					</p>
				</div>
				<div>
					<p class="text-xs uppercase tracking-wider text-[var(--deco-muted)]">
						{t('committedWager')}
					</p>
					<p
						data-testid="daily-challenge-committed-wager"
						class="text-2xl font-bold text-[var(--deco-ivory)]"
					>
						—
					</p>
				</div>
				<div>
					<p class="text-xs uppercase tracking-wider text-[var(--deco-muted)]">
						{t('progress')}
					</p>
					<p
						data-testid="daily-challenge-round-progress"
						class="text-2xl font-bold text-[var(--deco-ivory)]"
					>
						—
					</p>
				</div>
			</div>

			<div class="felt-table relative mb-6 rounded-3xl p-8" style="min-height: 480px">
				<div class="absolute top-14 left-1/2 w-full max-w-2xl -translate-x-1/2 px-4">
					<div
						class="rounded-2xl border border-[var(--deco-line)] bg-[var(--deco-obsidian-2)] p-3 backdrop-blur-sm"
					>
						<div class="mb-1 text-center">
							<div class="text-xs uppercase tracking-wider text-[var(--deco-muted)]">
								{t('dealer')}
							</div>
							<div
								data-testid="daily-challenge-dealer-value"
								class="inline-block rounded-full bg-[var(--deco-obsidian)] px-3 py-0.5 text-lg font-bold text-[var(--deco-ivory)]"
							>
								?
							</div>
						</div>
						<div
							data-testid="daily-challenge-dealer-hand"
							class="flex min-h-[64px] flex-wrap justify-center gap-2"
						>
						</div>
					</div>
				</div>
				<div class="absolute bottom-6 left-1/2 w-full max-w-2xl -translate-x-1/2 px-4">
					<div
						class="rounded-2xl border-2 border-[var(--deco-brass-dim)] bg-[var(--deco-obsidian-2)] p-3 backdrop-blur-sm"
					>
						<div class="mb-2 text-center text-xs uppercase tracking-wider text-[var(--deco-muted)]">
							{t('yourHands')}
						</div>
						<div data-testid="daily-challenge-player-hands" class="flex flex-col gap-3"></div>
					</div>
				</div>
			</div>

			<p
				data-testid="daily-challenge-status"
				role="status"
				aria-live="polite"
				class="mb-4 text-center text-lg font-semibold text-[var(--deco-brass)]"
			>
			</p>

			<div class="mb-6 flex flex-wrap items-end justify-center gap-3">
				<label
					class="flex flex-col gap-1 text-xs uppercase tracking-wider text-[var(--deco-muted)]"
				>
					{t('wager')}
					<input
						data-testid="daily-challenge-wager"
						type="number"
						min="10"
						max="1000"
						step="10"
						value="100"
						class="w-32 rounded-lg border border-[var(--deco-line)] bg-[var(--deco-obsidian)] px-3 py-2 text-lg font-bold text-[var(--deco-ivory)]"
					/>
				</label>
				<button
					type="button"
					data-testid="daily-challenge-start-ranked"
					class="deco-btn deco-btn-primary"
				>
					{t('startRanked')}
				</button>
				<button
					type="button"
					data-testid="daily-challenge-start-round"
					class="deco-btn deco-btn-primary"
				>
					{t('startRound')}
				</button>
				<button type="button" data-testid="daily-challenge-action-hit" class="deco-btn">
					{t('hit')}
				</button>
				<button type="button" data-testid="daily-challenge-action-stand" class="deco-btn">
					{t('stand')}
				</button>
				<button type="button" data-testid="daily-challenge-action-double-down" class="deco-btn">
					{t('doubleDown')}
				</button>
				<button type="button" data-testid="daily-challenge-action-split" class="deco-btn">
					{t('split')}
				</button>
				<button
					type="button"
					data-testid="daily-challenge-forfeit"
					class="deco-btn deco-btn-outline"
				>
					{t('forfeit')}
				</button>
				<button
					type="button"
					data-testid="daily-challenge-forfeit-confirm"
					class="deco-btn deco-btn-primary"
					hidden
				>
					{t('confirmForfeit')}
				</button>
				<button type="button" data-testid="daily-challenge-forfeit-cancel" class="deco-btn" hidden>
					{t('cancel')}
				</button>
			</div>

			<div class="mb-6 flex flex-wrap justify-center gap-3">
				<button type="button" data-testid="daily-challenge-restart-practice" class="deco-btn">
					{t('restartPractice')}
				</button>
			</div>

			<section
				data-testid="daily-challenge-receipt"
				class="deco-panel deco-frame mx-auto mb-6 max-w-md p-6 text-center"
				hidden
			>
				<p class="deco-section-eyebrow mb-2">{t('result')}</p>
				<p
					data-testid="daily-challenge-receipt-eligibility"
					class="text-lg font-bold text-[var(--deco-brass)]"
				>
				</p>
				<p
					data-testid="daily-challenge-receipt-bankroll"
					class="mt-2 text-3xl font-bold text-[var(--deco-ivory)]"
				>
				</p>
				<p
					data-testid="daily-challenge-receipt-rounds"
					class="mt-1 text-sm text-[var(--deco-muted)]"
				>
				</p>
				<p
					data-testid="daily-challenge-rank"
					class="mt-2 text-xl font-bold text-[var(--deco-brass)]"
				>
				</p>
				<p data-testid="daily-challenge-percentile" class="text-sm text-[var(--deco-muted)]"></p>
			</section>
		</section>

		<section class="mb-10" data-testid="daily-challenge-leaderboard">
			<div class="mb-4">
				<p class="deco-section-eyebrow">{t('todaysBest')}</p>
				<h2 class="deco-section-title text-3xl">{t('topResults')}</h2>
			</div>
			<p
				data-testid="daily-challenge-current-standing"
				class="mb-3 inline-block rounded-lg border border-[var(--deco-brass-dim)] bg-[var(--deco-obsidian-2)] px-4 py-2 text-sm font-semibold text-[var(--deco-brass)]"
				hidden
			>
			</p>
			<ol
				data-testid="daily-challenge-leaderboard-rows"
				class="divide-y divide-[var(--deco-line)] rounded-xl border border-[var(--deco-line)] bg-[var(--deco-obsidian-2)]"
			>
			</ol>
		</section>

		<section class="mb-10" data-testid="daily-challenge-weekly-leaderboard">
			<div class="mb-4">
				<p class="deco-section-eyebrow">{t('thisWeek')}</p>
				<h2 class="deco-section-title text-3xl">{t('weeklyResults')}</h2>
				<p class="mt-2 text-sm text-[var(--deco-muted)]">{t('weekRange')}</p>
			</div>
			<p
				data-testid="daily-challenge-weekly-current-standing"
				class="mb-3 inline-block rounded-lg border border-[var(--deco-brass-dim)] bg-[var(--deco-obsidian-2)] px-4 py-2 text-sm font-semibold text-[var(--deco-brass)]"
				hidden
			>
			</p>
			<p
				data-testid="daily-challenge-weekly-error"
				role="status"
				class="mb-3 text-sm text-[var(--deco-muted)]"
				hidden
			>
			</p>
			<ol
				data-testid="daily-challenge-weekly-leaderboard-rows"
				class="divide-y divide-[var(--deco-line)] rounded-xl border border-[var(--deco-line)] bg-[var(--deco-obsidian-2)]"
			>
			</ol>
		</section>

		<noscript>
			<div class="deco-panel deco-frame mt-10 p-6 text-center text-sm text-[var(--deco-muted)]">
				{t('noscript')}
			</div>
		</noscript>
	</main>
</CasinoLayout>

<script>
	import { initDailyChallengePage } from '../../lib/blackjack-run/daily-ui';

	const root = document.querySelector<HTMLElement>('#daily-challenge-root');
	if (root) void initDailyChallengePage(root);
</script>
