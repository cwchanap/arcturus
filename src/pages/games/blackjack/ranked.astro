---
import CasinoLayout from '../../../layouts/casino.astro';
import { blackjackTranslator } from '../../../lib/i18n/messages/blackjack';
import { formatChips } from '../../../lib/i18n/messages/common';
import { getGameName } from '../../../lib/i18n/messages/games';
import { formatWholeNumber } from '../../../lib/formatting';
import { MAXIMUM_WAGER, MINIMUM_WAGER } from '../../../lib/blackjack-run/ranked';

const user = Astro.locals.user;
const locale = Astro.locals.locale;
const t = blackjackTranslator(locale);
if (!user) return Astro.redirect('/signin');

const initialBalance =
	typeof user.chipBalance === 'number' && Number.isFinite(user.chipBalance)
		? Math.max(0, Math.trunc(user.chipBalance))
		: 0;
const initialWager = Math.min(100, Math.max(10, initialBalance));
---

<CasinoLayout title={t('pageTitle', { game: getGameName(locale, 'blackjack-ranked') })}>
	<main
		id="ranked-blackjack-root"
		data-testid="ranked-blackjack-root"
		data-initial-balance={initialBalance}
		class="mx-auto max-w-7xl px-4 py-8 sm:px-6 lg:px-8"
	>
		<header class="mb-8 flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
			<div>
				<a
					href="/games/blackjack"
					class="mb-3 inline-block text-[var(--deco-muted)] transition-colors hover:text-[var(--deco-brass)]"
				>
					← {t('backToCasual', { game: getGameName(locale, 'blackjack') })}
				</a>
				<div class="flex flex-wrap items-center gap-3">
					<h1 class="deco-section-title text-4xl">{getGameName(locale, 'blackjack')}</h1>
					<span
						class="rounded-full border border-[var(--deco-brass)] bg-[var(--deco-brass-dim)] px-3 py-1 text-xs font-bold uppercase tracking-[0.2em] text-[var(--deco-brass-bright)]"
					>
						{t('ranked')}
					</span>
				</div>
				<p class="mt-3 max-w-2xl text-sm leading-6 text-[var(--deco-muted)]">
					{t('rankedIntro')}
				</p>
			</div>

			<div
				class="grid grid-cols-2 gap-3 rounded-xl border border-[var(--deco-line)] bg-[var(--deco-obsidian-2)] p-4"
			>
				<div>
					<p class="text-xs uppercase tracking-wider text-[var(--deco-muted)]">{t('balance')}</p>
					<p
						id="ranked-balance"
						data-testid="ranked-balance"
						class="text-2xl font-bold text-[var(--deco-brass)]"
					>
						{formatChips(initialBalance, locale)}
					</p>
				</div>
				<div>
					<p class="text-xs uppercase tracking-wider text-[var(--deco-muted)]">{t('timeLeft')}</p>
					<p
						id="ranked-countdown"
						data-testid="ranked-countdown"
						class="font-mono text-2xl font-bold text-[var(--deco-ivory)]"
					>
						—
					</p>
				</div>
			</div>
		</header>

		<section
			class="felt-table relative mb-8 min-h-[560px] overflow-hidden rounded-3xl border border-[var(--deco-emerald-line)] p-6 sm:p-8"
			aria-label={t('tableAriaLabel', { game: getGameName(locale, 'blackjack-ranked') })}
		>
			<div class="mx-auto flex h-full max-w-4xl flex-col justify-between gap-16">
				<div class="text-center">
					<p class="mb-2 text-xs uppercase tracking-[0.2em] text-[var(--deco-muted)]">
						{t('dealer')}
					</p>
					<p
						id="ranked-dealer-value"
						data-testid="ranked-dealer-value"
						class="mb-4 text-lg font-bold text-[var(--deco-ivory)]"
					>
						—
					</p>
					<div
						id="ranked-dealer-hand"
						data-testid="ranked-dealer-hand"
						class="flex min-h-24 flex-wrap justify-center gap-3"
					>
					</div>
				</div>

				<div
					id="ranked-status"
					data-testid="ranked-status"
					role="status"
					aria-live="polite"
					class="mx-auto rounded-full border border-[var(--deco-brass-dim)] bg-[var(--deco-obsidian-2)] px-6 py-3 text-center font-semibold text-[var(--deco-brass)] shadow-xl"
				>
					{t('recoveringRun')}
				</div>

				<div class="text-center">
					<div class="mb-4 flex items-center justify-center gap-4">
						<p class="text-xs uppercase tracking-[0.2em] text-[var(--deco-muted)]">
							{t('playerHands')}
						</p>
						<p class="text-sm text-[var(--deco-brass)]">
							{t('committed')}
							<strong id="ranked-committed-wager" data-testid="ranked-committed-wager"
								>{formatChips(0, locale)}</strong
							>
						</p>
					</div>
					<div
						id="ranked-player-hands"
						data-testid="ranked-player-hands"
						class="grid min-h-36 gap-4 sm:grid-cols-2 lg:grid-cols-4"
					>
					</div>
				</div>
			</div>
		</section>

		<div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.7fr)]">
			<section
				class="rounded-xl border border-[var(--deco-line)] bg-[var(--deco-obsidian-2)] p-6"
				aria-labelledby="ranked-controls-title"
			>
				<h2 id="ranked-controls-title" class="mb-5 text-xl font-bold text-[var(--deco-ivory)]">
					{t('rankedControls')}
				</h2>
				<div class="grid gap-5 sm:grid-cols-[180px_1fr]">
					<div>
						<label
							for="ranked-wager"
							class="mb-2 block text-sm font-medium text-[var(--deco-muted)]"
						>
							{
								t('wagerLabel', {
									min: formatWholeNumber(MINIMUM_WAGER, locale),
									max: formatWholeNumber(MAXIMUM_WAGER, locale),
								})
							}
						</label>
						<input
							id="ranked-wager"
							data-testid="ranked-wager"
							type="number"
							min="10"
							max="1000"
							step="10"
							value={initialWager}
							disabled
							class="w-full rounded-lg border border-[var(--deco-line)] bg-[var(--deco-obsidian)] px-4 py-3 text-lg text-[var(--deco-ivory)] outline-none focus:border-[var(--deco-brass)] disabled:cursor-not-allowed disabled:opacity-50"
						/>
						<button
							id="ranked-start"
							data-testid="ranked-start"
							type="button"
							disabled
							class="mt-3 w-full rounded-lg bg-linear-to-r from-[var(--deco-brass-bright)] to-[var(--deco-brass)] px-5 py-3 font-bold text-[var(--deco-obsidian)] disabled:cursor-not-allowed disabled:opacity-40"
						>
							{t('startRankedRun')}
						</button>
					</div>

					<div id="ranked-actions" data-testid="ranked-actions" class="grid grid-cols-2 gap-3">
						<button
							id="ranked-action-hit"
							data-testid="ranked-action-hit"
							data-ranked-action="hit"
							type="button"
							disabled
							class="rounded-lg border border-[var(--deco-brass-dim)] bg-[var(--deco-obsidian-3)] px-4 py-3 font-bold text-[var(--deco-ivory)] disabled:cursor-not-allowed disabled:opacity-35"
						>
							{t('hit')}
						</button>
						<button
							id="ranked-action-stand"
							data-testid="ranked-action-stand"
							data-ranked-action="stand"
							type="button"
							disabled
							class="rounded-lg border border-[var(--deco-brass-dim)] bg-[var(--deco-obsidian-3)] px-4 py-3 font-bold text-[var(--deco-ivory)] disabled:cursor-not-allowed disabled:opacity-35"
						>
							{t('stand')}
						</button>
						<button
							id="ranked-action-double-down"
							data-testid="ranked-action-double-down"
							data-ranked-action="double-down"
							type="button"
							disabled
							class="rounded-lg border border-[var(--deco-brass-dim)] bg-[var(--deco-obsidian-3)] px-4 py-3 font-bold text-[var(--deco-ivory)] disabled:cursor-not-allowed disabled:opacity-35"
						>
							{t('doubleDown')}
						</button>
						<button
							id="ranked-action-split"
							data-testid="ranked-action-split"
							data-ranked-action="split"
							type="button"
							disabled
							class="rounded-lg border border-[var(--deco-brass-dim)] bg-[var(--deco-obsidian-3)] px-4 py-3 font-bold text-[var(--deco-ivory)] disabled:cursor-not-allowed disabled:opacity-35"
						>
							{t('split')}
						</button>
					</div>
				</div>
				<p class="mt-5 text-xs leading-5 text-[var(--deco-muted)]">
					{t('rankAuthorityNote')}
				</p>
			</section>

			<section
				id="ranked-result"
				data-testid="ranked-result"
				hidden
				class="rounded-xl border border-[var(--deco-brass-dim)] bg-[var(--deco-obsidian-2)] p-6"
				aria-labelledby="ranked-result-title"
			>
				<h2 id="ranked-result-title" class="mb-4 text-xl font-bold text-[var(--deco-brass)]">
					{t('result')}
				</h2>
				<dl class="space-y-4 text-sm">
					<div>
						<dt class="text-[var(--deco-muted)]">{t('resultOutcome')}</dt>
						<dd
							id="ranked-result-outcome"
							data-testid="ranked-result-outcome"
							class="mt-1 text-lg font-bold text-[var(--deco-ivory)]"
						>
						</dd>
					</div>
					<div>
						<dt class="text-[var(--deco-muted)]">{t('resultCommittedWager')}</dt>
						<dd
							id="ranked-result-wager"
							data-testid="ranked-result-wager"
							class="mt-1 font-semibold text-[var(--deco-ivory)]"
						>
						</dd>
					</div>
					<div>
						<dt class="text-[var(--deco-muted)]">{t('resultPayout')}</dt>
						<dd
							id="ranked-result-payout"
							data-testid="ranked-result-payout"
							class="mt-1 font-semibold text-[var(--deco-ivory)]"
						>
						</dd>
					</div>
					<div>
						<dt class="text-[var(--deco-muted)]">{t('resultNet')}</dt>
						<dd
							id="ranked-result-net"
							data-testid="ranked-result-net"
							class="mt-1 font-semibold text-[var(--deco-ivory)]"
						>
						</dd>
					</div>
					<div>
						<dt class="text-[var(--deco-muted)]">{t('resultFinalBalance')}</dt>
						<dd
							id="ranked-result-balance"
							data-testid="ranked-result-balance"
							class="mt-1 font-semibold text-[var(--deco-ivory)]"
						>
						</dd>
					</div>
				</dl>
			</section>
		</div>
	</main>
</CasinoLayout>

<script>
	import { createBlackjackRunClient } from '../../../lib/blackjack-run/client';
	import { createRankedRunRenderer } from '../../../lib/blackjack-run/ranked-ui';
	import { blackjackTranslator } from '../../../lib/i18n/messages/blackjack';
	import { getDocumentLocale } from '../../../lib/i18n/locale';
	import type { BlackjackRunPublicState } from '../../../lib/blackjack-run/protocol';

	const root = document.getElementById('ranked-blackjack-root');
	if (root) {
		const locale = getDocumentLocale(root.ownerDocument);
		const renderer = createRankedRunRenderer(root);
		const client = createBlackjackRunClient({ locale });
		const t = blackjackTranslator(locale);
		let current: BlackjackRunPublicState | null = null;
		let countdownHandle: ReturnType<typeof setInterval> | null = null;

		const stopCountdown = (): void => {
			if (countdownHandle !== null) {
				clearInterval(countdownHandle);
				countdownHandle = null;
			}
		};

		const startCountdown = (state: BlackjackRunPublicState): void => {
			stopCountdown();
			if (state.status !== 'active') return;
			const tick = (): void => {
				const secondsRemaining = Math.max(
					0,
					Math.ceil((state.expiresAt * 1000 - Date.now()) / 1000),
				);
				renderer.renderCountdown(secondsRemaining);
				if (secondsRemaining <= 0) {
					// TTL reached: stop the interval and reload the authoritative
					// run by ID so the expired result renders instead of a frozen
					// countdown at 0:00.
					stopCountdown();
					void request(() => client.loadRun(state.runId));
				}
			};
			tick();
			countdownHandle = setInterval(tick, 1000);
		};

		const adopt = (state: BlackjackRunPublicState | null): void => {
			current = state;
			renderer.render(state?.mode === 'ranked' ? state : null);
			if (state?.mode === 'ranked') {
				startCountdown(state);
			} else {
				stopCountdown();
			}
		};

		const fail = (error: unknown): void => {
			renderer.renderError(error instanceof Error ? error.message : t('requestFailed'));
		};

		/**
		 * Runs one guarded client request at a time. While a request is in
		 * flight the renderer is pending, so duplicate clicks are ignored by
		 * the disabled controls instead of surfacing the client's in-flight
		 * guard as an error. Clearing pending on settle also restores the
		 * idle/rendered controls after a failed load or run request, so the
		 * user can start or retry after an initial load failure.
		 */
		const request = (operation: () => Promise<BlackjackRunPublicState | null>): void => {
			renderer.setPending(true);
			operation()
				.then(adopt)
				.catch(fail)
				.finally(() => {
					renderer.setPending(false);
				});
		};

		renderer.bind({
			onStart(wager) {
				request(() => client.startRanked(wager));
			},
			onAction(action) {
				if (!current || current.status !== 'active') return;
				const runId = current.runId;
				request(() => client.command(runId, { command: action }));
			},
		});

		request(() => client.loadCurrent('ranked'));
	}
</script>
