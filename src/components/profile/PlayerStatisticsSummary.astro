---
import { formatPercentage, formatWholeNumber } from '../../lib/formatting';
import { getGameName } from '../../lib/i18n/messages/games';
import { formatSignedProfit, profileTranslator } from '../../lib/i18n/messages/profile';
import type { ProfileStatisticsState } from '../../lib/profile-statistics-loader';

interface Props {
	state: ProfileStatisticsState;
}

const { state } = Astro.props;
const locale = Astro.locals.locale;
const t = profileTranslator(locale);
---

<section class="deco-panel mt-8 p-6" aria-labelledby="player-performance-heading">
	<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
		<div>
			<p class="deco-eyebrow-sm">{t('allTimeCasualPlay')}</p>
			<h2 id="player-performance-heading" class="deco-section-title text-lg">
				{t('playerPerformance')}
			</h2>
		</div>
		<a href="/profile/statistics" class="deco-link">{t('viewDetailedStatistics')}</a>
	</div>
	{
		state.status === 'error' ? (
			<p class="mt-6" role="status" style="color: var(--deco-rose)">
				{t('statisticsUnavailable')}
			</p>
		) : (
			<dl class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
				<div>
					<dt class="deco-eyebrow-sm">{t('totalHands')}</dt>
					<dd class="deco-stat-value mt-1 tabular-nums">
						{formatWholeNumber(state.summary.totalHands, locale)}
					</dd>
				</div>
				<div>
					<dt class="deco-eyebrow-sm">{t('mostPlayed')}</dt>
					<dd class="deco-stat-value mt-1 tabular-nums">
						{state.summary.mostPlayedGame
							? getGameName(locale, state.summary.mostPlayedGame)
							: t('noGamesPlayedYet')}
					</dd>
				</div>
				<div>
					<dt class="deco-eyebrow-sm">{t('overallWinRate')}</dt>
					<dd class="deco-stat-value mt-1 tabular-nums">
						{formatPercentage(state.summary.overallWinRate, locale)}
					</dd>
				</div>
				<div>
					<dt class="deco-eyebrow-sm">{t('netProfit')}</dt>
					<dd class="deco-stat-value mt-1 tabular-nums">
						{formatSignedProfit(state.summary.totalNetProfit, locale)}
					</dd>
				</div>
			</dl>
		)
	}
</section>
