---
import CabinetDrawer from '../../components/CabinetDrawer.astro';
import TableCabinetHeader from '../../components/TableCabinetHeader.astro';
import DecoIcon from '../../components/DecoIcon.astro';
import '../../styles/table-cabinet.css';
import '../../styles/sic-bo.css';
import { cabinetTranslator } from '../../lib/i18n/messages/cabinet';
import CasinoLayout from '../../layouts/casino.astro';
import { createPublicGameSession } from '../../lib/public-game-session';
import { sicBoTranslator, type SIC_BO_MESSAGES } from '../../lib/i18n/messages/sic-bo';
import { getGameName } from '../../lib/i18n/messages/games';
import { formatChips, getBalanceLabel } from '../../lib/i18n/messages/common';
import type { MessageKey } from '../../lib/i18n/translate';
import { SIC_BO_CHIP_DENOMINATIONS, TOTAL_ODDS } from '../../lib/sic-bo';
import type { SicBoBetKey } from '../../lib/sic-bo';

const locale = Astro.locals.locale;
const t = sicBoTranslator(locale);
const cabinet = cabinetTranslator(locale);
const gameSession = createPublicGameSession(Astro.locals.user);

const PRIMARY_BET_LABEL_KEYS: Record<
	'big' | 'small' | 'odd' | 'even' | 'any-triple',
	MessageKey<typeof SIC_BO_MESSAGES>
> = {
	big: 'betBig',
	small: 'betSmall',
	odd: 'betOdd',
	even: 'betEven',
	'any-triple': 'betAnyTriple',
};

const primaryBets: Array<{ key: 'big' | 'small' | 'odd' | 'even' | 'any-triple'; odds: string }> = [
	{ key: 'big', odds: '1:1' },
	{ key: 'small', odds: '1:1' },
	{ key: 'odd', odds: '1:1' },
	{ key: 'even', odds: '1:1' },
	{ key: 'any-triple', odds: '24:1' },
];

const totalBets: Array<{ key: SicBoBetKey; label: string; odds: string }> = Object.entries(
	TOTAL_ODDS,
).map(([total, odds]) => ({
	key: `total:${total}` as SicBoBetKey,
	label: total,
	odds: `${odds}:1`,
}));

// Paytable A symmetric groups: 4/17, 5/16, 6/15, 7/14, 8/13, 9–12.
const paytableTotalRows: Array<{ label: string; odds: string }> = [4, 5, 6, 7, 8].map((n) => ({
	label: `${n} / ${21 - n}`,
	odds: `${TOTAL_ODDS[n as keyof typeof TOTAL_ODDS]}:1`,
}));
---

<CasinoLayout title={t('pageTitle', { game: getGameName(locale, 'sic-bo') })} footerClass="hidden">
	<div
		id="sic-bo-root"
		data-testid="sic-bo-root"
		data-user-id={gameSession.clientUserId}
		data-guest-mode={gameSession.guestModeValue}
		data-initial-balance={gameSession.initialBalance}
		class="table-cabinet sic-bo-cabinet"
	>
		<div class="tc-interior">
			<TableCabinetHeader
				title={getGameName(locale, 'sic-bo')}
				backLabel={t('backToGames')}
				tag={t('paytableA')}
				balance={formatChips(gameSession.initialBalance, locale)}
				balanceLabel={getBalanceLabel(locale, gameSession.isGuest)}
			>
				<span class="tc-top">{cabinet('top')} <strong>50 : 1</strong></span>
				<button
					type="button"
					aria-haspopup="dialog"
					class="tc-icon"
					data-cabinet-panel="sic-bo-history"
					aria-controls="sic-bo-history"
					aria-expanded="false"
					aria-label={cabinet('history')}
					title={cabinet('history')}><DecoIcon name="menu" size={17} /></button
				>
				<button
					type="button"
					aria-haspopup="dialog"
					class="tc-icon"
					data-cabinet-panel="sic-bo-paytable"
					aria-controls="sic-bo-paytable"
					aria-expanded="false"
					aria-label={t('paytableA')}
					title={t('paytableA')}>?</button
				>
			</TableCabinetHeader>
			<section class="tc-stage" aria-label={t('subtitle')}>
				<div class="tc-rays" aria-hidden="true"></div>
				<div class="tc-dice">
					{
						[0, 1, 2].map((i) => (
							<div
								id={`sic-bo-die-${i}`}
								data-testid={`sic-bo-die-${i}`}
								data-value="0"
								class="tc-die"
							>
								<span data-die-value>—</span>
								{Array.from({ length: 9 }, () => (
									<i class="tc-pip" aria-hidden="true" />
								))}
							</div>
						))
					}
				</div>
				<div class="sic-bo-total">
					<div class="tc-diamond">
						<strong id="sic-bo-total">—</strong><small>{cabinet('total')}</small>
					</div><div
						id="sic-bo-result"
						data-testid="sic-bo-result"
						role="status"
						aria-live="polite"
					>
					</div>
				</div>
			</section>
			<section class="tc-content">
				<div class="sic-bo-primary">
					{
						primaryBets.map((bet) => (
							<button
								type="button"
								data-bet-key={bet.key}
								aria-pressed="false"
								class="sic-bo-bet-button"
							>
								<>
									<span class="sic-bo-bet-label">{t(PRIMARY_BET_LABEL_KEYS[bet.key])}</span>
									<span class="sic-bo-bet-odds">{bet.odds}</span>
									<span class="sic-bo-bet-amount" data-bet-amount />
								</>
							</button>
						))
					}
				</div>
				<div class="sic-bo-totals">
					{
						totalBets.map((bet) => (
							<button
								type="button"
								data-bet-key={bet.key}
								aria-pressed="false"
								class="sic-bo-bet-button"
							>
								<>
									<span class="sic-bo-bet-label">{bet.label}</span>
									<span class="sic-bo-bet-odds">{bet.odds}</span>
									<span class="sic-bo-bet-amount" data-bet-amount />
								</>
							</button>
						))
					}
				</div>
				<div class="tc-divider" aria-hidden="true">◆ ◇ ◆</div>
				<div class="tc-controls">
					<div class="tc-chips">
						<span class="tc-label">{cabinet('chip')}</span>{
							SIC_BO_CHIP_DENOMINATIONS.map((amount) => (
								<button
									type="button"
									data-denomination={amount}
									aria-pressed="false"
									class="tc-chip"
									aria-label={formatChips(amount, locale)}
								>
									{amount}
								</button>
							))
						}
					</div>
					<span id="sic-bo-total-stake" data-testid="sic-bo-total-stake" class="tc-stake"
						>{t('totalStake', { amount: formatChips(0, locale) })}</span
					>
					<button
						type="button"
						id="sic-bo-clear-bets"
						data-testid="sic-bo-clear-bets"
						class="tc-button">{t('clearBets')}</button
					>
					<button
						type="button"
						id="sic-bo-action"
						data-testid="sic-bo-action"
						class="tc-primary"
						disabled>{t('roll')}</button
					>
				</div>
				<div
					id="sic-bo-status"
					data-testid="sic-bo-status"
					role="status"
					aria-live="polite"
					class="tc-status"
				>
					{t('chooseDenomination')}
				</div>
				<div id="sic-bo-recovery-host" class="tc-controls"></div>
			</section>
		</div>
		<CabinetDrawer id="sic-bo-paytable" title={t('paytableA')} closeLabel={cabinet('close')}>
			<p class="tc-empty">{t('paytableNote')}</p>
			<div class="tc-pay-row"><span>{t('paytablePrimary')}</span><span>1:1</span></div>
			<div class="tc-pay-row"><span>{t('paytableAnyTriple')}</span><span>24:1</span></div>
			{
				paytableTotalRows.map((row) => (
					<div class="tc-pay-row">
						<>
							<span>{t('paytableTotal', { value: row.label })}</span>
							<span>{row.odds}</span>
						</>
					</div>
				))
			}
			<div class="tc-pay-row">
				<span>{t('paytableTotal', { value: '9–12' })}</span><span>6:1</span>
			</div>
		</CabinetDrawer>
		<CabinetDrawer id="sic-bo-history" title={cabinet('history')} closeLabel={cabinet('close')}
			><ol id="sic-bo-recent"></ol><p class="tc-empty">{cabinet('noHistory')}</p></CabinetDrawer
		>
	</div>
</CasinoLayout>
<script>
	import { initSicBoClient } from '../../lib/sic-bo/client';
	initSicBoClient();
</script>
