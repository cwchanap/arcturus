---
import '../styles/global.css';
import '@fontsource/playfair-display/500.css';
import '@fontsource/playfair-display/700.css';
import '@fontsource/playfair-display/800.css';
import '@fontsource/playfair-display/500-italic.css';
import '@fontsource/jost/400.css';
import '@fontsource/jost/500.css';
import '@fontsource/jost/600.css';
import UserNav from '../components/UserNav.astro';
import DecoIcon from '../components/DecoIcon.astro';
import DecoDivider from '../components/DecoDivider.astro';
import LanguagePicker from '../components/LanguagePicker.astro';
import { formatChips, SHELL_MESSAGES } from '../lib/i18n/messages/common';
import { getGameName } from '../lib/i18n/messages/games';
import { createTranslator } from '../lib/i18n/translate';

interface Props {
	title?: string;
	headerSticky?: boolean;
	bodyClass?: string;
	footerClass?: string;
}

const {
	title = 'Arcturus Casino',
	headerSticky: headerStickyProp,
	bodyClass = 'bg-[var(--deco-obsidian)] text-[var(--deco-ivory)]',
	footerClass = 'mt-20',
} = Astro.props as Props;
const headerSticky = headerStickyProp ?? true;
const locale = Astro.locals.locale;
const t = createTranslator(SHELL_MESSAGES, locale);
const session = Astro.locals.session;
const user = Astro.locals.user ?? session?.user ?? null;
const headerPositionClass = headerSticky ? 'sticky top-0 z-50' : '';
const rawChipBalance = user?.chipBalance;
const parsedChipBalance =
	typeof rawChipBalance === 'number'
		? rawChipBalance
		: typeof rawChipBalance === 'string'
			? Number(rawChipBalance)
			: null;
const chipBalance = Number.isFinite(parsedChipBalance)
	? (parsedChipBalance as number)
	: user
		? 0
		: null;
const formattedChipBalance = chipBalance === null ? null : formatChips(chipBalance, locale);
---

<html lang={locale} data-locale={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class={bodyClass}>
		<div class="flex min-h-screen flex-col">
			<header class={`deco-header deco-grain ${headerPositionClass}`.trim()}>
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
					<div class="flex justify-between items-center h-20">
						<a href="/" class="group flex items-center gap-3">
							<DecoIcon
								name="star"
								size={30}
								class="text-[var(--deco-brass)] transition-transform duration-300 group-hover:rotate-45"
							/>
							<div class="leading-tight">
								<div class="deco-wordmark text-2xl">ARCTURUS</div>
								<div class="deco-rule my-1"></div>
								<div class="deco-eyebrow">{t('premiumCasino')}</div>
							</div>
						</a>

						<nav class="hidden md:flex items-center gap-8">
							<a href="/missions" class="deco-link">{t('missions')}</a>
							<a href="/games/leaderboard" class="deco-link">{t('leaderboard')}</a>
						</nav>

						<div class="flex items-center gap-4">
							<LanguagePicker />
							{
								user && (
									<div class="hidden md:block">
										<div class="deco-chip-pill">
											<DecoIcon name="chip" size={18} class="text-[var(--deco-brass)]" />
											<span class="font-body font-medium tabular-nums" data-chip-balance>
												{formattedChipBalance ?? formatChips(0, locale)}
											</span>
										</div>
									</div>
								)
							}
							<UserNav />
						</div>
					</div>
				</div>
			</header>
			<main class="flex-1">
				<slot />
			</main>
			<footer class={`deco-footer ${footerClass}`.trim()}>
				<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
					<DecoDivider class="mb-10" />
					<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
						<div>
							<h3 class="deco-heading text-lg mb-4">{t('games')}</h3>
							<ul class="space-y-2">
								<li><a href="/#games" class="deco-footer-link">{t('allGames')}</a></li>
								<li>
									<a href="/games/poker" class="deco-footer-link">{getGameName(locale, 'poker')}</a>
								</li>
								<li>
									<a href="/games/blackjack" class="deco-footer-link"
										>{getGameName(locale, 'blackjack')}</a
									>
								</li>
							</ul>
						</div>
						<div>
							<h3 class="deco-heading text-lg mb-4">Arcturus</h3>
							<ul class="space-y-2">
								<li><a href="/missions" class="deco-footer-link">{t('missions')}</a></li>
								<li>
									<a href="/games/leaderboard" class="deco-footer-link">{t('leaderboard')}</a>
								</li>
								<li><a href="/profile" class="deco-footer-link">{t('profile')}</a></li>
							</ul>
						</div>
						<div>
							<h3 class="deco-heading text-lg mb-4">{t('legal')}</h3>
							<ul class="space-y-2">
								<li><a href="#" class="deco-footer-link">{t('responsibleGaming')}</a></li>
								<li><a href="#" class="deco-footer-link">{t('adultsOnly')}</a></li>
							</ul>
						</div>
					</div>
					<div class="deco-rule mt-10 mb-6"></div>
					<p class="text-center text-sm" style="color: var(--deco-muted)">
						{t('copyright', { year: new Date().getFullYear() })}
					</p>
				</div>
			</footer>
		</div>
	</body>
</html>
