---
import DecoIcon from './DecoIcon.astro';
import { SHELL_MESSAGES } from '../lib/i18n/messages/common';
import { createTranslator } from '../lib/i18n/translate';

const user = Astro.locals.user;
const t = createTranslator(SHELL_MESSAGES, Astro.locals.locale);
---

<div class="flex items-center gap-4">
	{
		user ? (
			<div class="flex items-center gap-3">
				{user.image ? (
					<img
						src={user.image}
						alt={user.name}
						class="h-8 w-8 rounded-full"
						style="border: 1px solid var(--deco-brass)"
					/>
				) : (
					<span
						class="flex h-8 w-8 items-center justify-center rounded-full"
						style="border: 1px solid var(--deco-brass); color: var(--deco-brass)"
					>
						<DecoIcon name="user" size={16} />
					</span>
				)}
				<span class="font-body hidden text-sm sm:inline" style="color: var(--deco-ivory)">
					{user.name}
				</span>
				<a href="/profile" class="deco-link">
					{t('profile')}
				</a>
			</div>
		) : (
			<div class="flex items-center gap-3">
				<a href="/signin" class="deco-link">
					{t('signIn')}
				</a>
				<a href="/signin" class="deco-btn deco-btn-primary">
					{t('joinFree')}
				</a>
			</div>
		)
	}
</div>
