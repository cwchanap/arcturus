{
	"name": "arcturus",
	"type": "module",
	"version": "0.0.1",
	"scripts": {
		"dev": "astro dev",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"db:generate": "drizzle-kit generate",
		"db:push": "drizzle-kit push",
		"db:migrate:local": "WRANGLER_LOG_PATH=.wrangler/logs bun scripts/apply-migrations.ts",
		"db:migrate:remote": "WRANGLER_LOG_PATH=.wrangler/logs bun scripts/apply-migrations.ts --remote",
		"db:studio": "drizzle-kit studio",
		"setup:db": "bun scripts/setup-local-db.ts",
		"deploy": "astro build && wrangler deploy",
		"prepare": "husky",
		"lint": "eslint . --max-warnings 0",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun test src/ && vitest run",
		"test:unit": "bun test src/",
		"test:integration": "vitest run",
		"test:coverage": "bun test src/ --coverage --coverage-reporter=text --coverage-reporter=lcov",
		"test:e2e": "playwright test",
		"test:e2e:ci": "bun run db:migrate:local && playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:report": "playwright show-report",
		"test:e2e:mp": "bun run db:migrate:local && MP_E2E=1 bunx playwright test e2e/multiplayer-poker.spec.ts --config playwright.config.mp.ts"
	},
	"lint-staged": {
		"*.{js,mjs,ts,tsx,astro}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,css}": [
			"prettier --write"
		]
	},
	"dependencies": {
		"@libsql/client": "^0.18.0",
		"@noble/hashes": "^2.4.0",
		"@tailwindcss/vite": "^4.3.5",
		"@types/canvas-confetti": "^1.9.0",
		"astro": "^6.4.8",
		"better-auth": "^1.7.18",
		"better-call": "^1.4.5",
		"better-sqlite3": "^13.0.3",
		"canvas-confetti": "^1.9.4",
		"drizzle-orm": "^0.45.4",
		"tailwindcss": "^4.3.5",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/cloudflare": "^13.7.0",
		"@cloudflare/workers-types": "^5.20261106.1",
		"@eslint/js": "^10.0.1",
		"@fontsource/jost": "^5.3.0",
		"@fontsource/playfair-display": "^5.3.0",
		"@playwright/test": "^1.65.0",
		"@types/bun": "^1.4.3",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-astro": "^3.2.1",
		"happy-dom": "20.14.5",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"miniflare": "4.20260730.0",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "^1.1.1",
		"typescript": "6",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.1.0",
		"wrangler": "^4.158.0"
	}
}
