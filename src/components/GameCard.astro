---
import GameEmblem from './GameEmblem.astro';
import DecoIcon from './DecoIcon.astro';
import { formatWholeNumber } from '../lib/formatting';
import { formatChips } from '../lib/i18n/messages/common';
import { gameCardTranslator } from '../lib/i18n/messages/home';
import { getGameName, type GameNameKey } from '../lib/i18n/messages/games';

interface Props {
	gameKey: GameNameKey;
	emblem: 'cards' | 'dice' | 'wheel' | 'spark';
	players: number;
	minBet: number;
	href: string;
	featured?: boolean;
	icon?: string;
}

const { gameKey, emblem, players, minBet, href, featured = false, icon } = Astro.props;
const locale = Astro.locals.locale;
const t = gameCardTranslator(locale);
const name = getGameName(locale, gameKey);
const formattedPlayers = formatWholeNumber(players, locale);
const formattedMinBet = formatChips(minBet, locale);
---

<a href={href} class="deco-card group block">
	{
		featured && (
			<div class="absolute top-3 right-3 z-10">
				<span class="deco-badge">{t('featured')}</span>
			</div>
		)
	}

	<div class="deco-emblem-frame relative h-44 border-b border-[var(--deco-brass)]/20">
		{
			icon ? (
				<span
					class="absolute inset-0 flex items-center justify-center text-6xl transition-transform duration-300 group-hover:scale-110"
					aria-hidden="true"
				>
					{icon}
				</span>
			) : (
				<GameEmblem
					kind={emblem}
					size={84}
					class="transition-transform duration-300 group-hover:scale-110"
				/>
			)
		}
	</div>

	<div class="p-6">
		<h3 class="deco-section-title mb-3 text-xl">{name}</h3>

		<div class="mb-5 flex items-center gap-5 text-sm" style="color: var(--deco-ivory-dim)">
			<span class="flex items-center gap-1.5">
				<DecoIcon name="user" size={15} class="text-[var(--deco-brass)]" />
				<span class="tabular-nums">{t('playersPlaying', { count: formattedPlayers })}</span>
			</span>
			<span class="flex items-center gap-1.5">
				<DecoIcon name="chip" size={15} class="text-[var(--deco-brass)]" />
				<span class="tabular-nums">{t('minBet', { minBet: formattedMinBet })}</span>
			</span>
		</div>

		<span class="deco-btn deco-btn-primary w-full">{t('play')}</span>
	</div>
</a>
