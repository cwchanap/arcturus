---
import CasinoLayout from '../layouts/casino.astro';
import { createDb } from '../lib/db';
import DecoIcon from '../components/DecoIcon.astro';
import { AI_MODELS, AI_PROVIDERS } from '../lib/ai';
import { getAchievementsWithStatus } from '../lib/achievements/achievements';
import type { AchievementWithStatus } from '../lib/achievements/types';
import PlayerStatisticsSummary from '../components/profile/PlayerStatisticsSummary.astro';
import {
	loadProfileStatisticsState,
	type ProfileStatisticsState,
} from '../lib/profile-statistics-loader';

const session = Astro.locals.session;

if (!session) {
	return Astro.redirect('/signin');
}

Astro.response.headers.set('Cache-Control', 'private, no-store');
let playerStatisticsState: ProfileStatisticsState = { status: 'error' };

const { user } = session;
const fallbackInitial = user?.name?.[0]?.toUpperCase() ?? user?.email?.[0]?.toUpperCase() ?? 'A';

const runtime = Astro.locals.runtime;

const dbBinding = runtime?.env?.DB ?? null;

// Achievements data
let achievements: AchievementWithStatus[] = [];
let achievementProgress = { total: 0, unlocked: 0, percentage: 0 };
let achievementsFetchError = false;
const clampedPercentage = () =>
	Math.round(Math.min(100, Math.max(0, achievementProgress.percentage)));

if (dbBinding) {
	const db = createDb(dbBinding);

	// The two profile reads are independent — run them concurrently to keep
	// profile TTFB to a single D1 round trip window instead of two sequential
	// ones. Each loader captures its own error state so a failure in one does
	// not mask or abort the others.
	const [statsState, achievementsResult] = await Promise.all([
		loadProfileStatisticsState(db, user.id),
		(async () => {
			try {
				return { ok: true as const, value: await getAchievementsWithStatus(db, user.id) };
			} catch (error) {
				console.error('Error loading achievements:', error);
				return { ok: false as const };
			}
		})(),
	]);

	playerStatisticsState = statsState;

	if (achievementsResult.ok) {
		achievements = achievementsResult.value;
		// Calculate progress from the already-fetched achievements (avoids duplicate DB query)
		const unlocked = achievements.filter((a) => a.isUnlocked).length;
		const total = achievements.length;
		achievementProgress = {
			total,
			unlocked,
			percentage: total > 0 ? (unlocked / total) * 100 : 0,
		};
	} else {
		achievementsFetchError = true;
	}
}

const aiModelOptions = AI_MODELS;
const aiProviderOptions = AI_PROVIDERS;
const providerLabels = {
	openai: 'OpenAI',
	gemini: 'Gemini',
} as const;
const modelLabels: Record<string, string> = {
	'gpt-4o': 'GPT-4o',
	'gemini-2.5-flash': 'Gemini 2.5 Flash',
	'gemini-2.5-flash-lite': 'Gemini 2.5 Flash Lite',
};
const initialAiProvider = 'openai' as const;
const initialAiModel = AI_MODELS[initialAiProvider][0];
---

<CasinoLayout title="Player Profile - Arcturus Casino">
	<section class="deco-atmosphere relative overflow-hidden">
		<div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
			<div class="deco-panel deco-frame">
				<div class="flex flex-col gap-10 p-8 sm:p-12">
					<div class="flex flex-col md:flex-row md:items-center md:justify-between gap-8">
						<div class="flex items-center gap-5">
							<div
								data-testid="user-avatar"
								class="flex h-20 w-20 items-center justify-center rounded-sm text-3xl font-bold"
								style="border: 1px solid var(--deco-brass); color: var(--deco-brass); background: linear-gradient(160deg, rgba(12,51,38,0.6), rgba(11,15,14,0.9)); font-family: var(--font-display)"
							>
								{
									user.image ? (
										<img
											src={user.image}
											alt={user.name ?? user.email ?? 'Player Avatar'}
											class="h-20 w-20 rounded-sm object-cover"
										/>
									) : (
										<span>{fallbackInitial}</span>
									)
								}
							</div>
							<div>
								<p class="deco-eyebrow-sm">Player Profile</p>
								<h1 class="deco-section-title mt-2 text-3xl">
									{user.name ?? 'Casino Adventurer'}
								</h1>
								<p class="deco-text-dim">{user.email}</p>
							</div>
						</div>
						<div class="flex items-center gap-4 self-start md:self-auto">
							<span class:list={['deco-pill', user.emailVerified && 'deco-pill-success']}>
								{user.emailVerified ? 'Email Verified' : 'Verification Pending'}
							</span>
							<button id="signout-btn" type="button" class="deco-btn deco-btn-outline">
								<span>Sign out</span>
							</button>
						</div>
					</div>

					<div class="grid grid-cols-1 gap-6 md:grid-cols-2">
						<div class="deco-panel p-6">
							<h2 class="deco-section-title text-lg">Account Details</h2>
							<dl class="deco-text-dim mt-6 space-y-4 text-sm">
								<div class="flex items-start justify-between">
									<dt class="deco-muted-text">Player Name</dt>
									<dd class="deco-text font-medium">{user.name ?? 'Not set'}</dd>
								</div>
								<div class="flex items-start justify-between">
									<dt class="deco-muted-text">Email Address</dt>
									<dd class="deco-text font-medium">{user.email}</dd>
								</div>
								<div class="flex items-start justify-between">
									<dt class="deco-muted-text">Email Status</dt>
									<dd class="deco-text font-medium">
										{user.emailVerified ? 'Verified' : 'Awaiting verification'}
									</dd>
								</div>
							</dl>
						</div>
						<div class="deco-panel p-6">
							<h2 class="deco-section-title text-lg">Casino Tips</h2>
							<ul class="deco-text-dim mt-6 space-y-4 text-sm">
								<li class="flex items-start gap-3">
									<DecoIcon
										name="chip"
										size={18}
										class="mt-0.5 shrink-0 text-[var(--deco-brass)]"
									/>
									<span>Claim your daily chip bonus to keep the games going.</span>
								</li>
								<li class="flex items-start gap-3">
									<DecoIcon
										name="trophy"
										size={18}
										class="mt-0.5 shrink-0 text-[var(--deco-brass)]"
									/>
									<span>Try a different single-player table to explore another strategy.</span>
								</li>
								<li class="flex items-start gap-3">
									<DecoIcon
										name="star"
										size={18}
										class="mt-0.5 shrink-0 text-[var(--deco-brass)]"
									/>
									<span>Create a private poker room and share its code for a casual match.</span>
								</li>
							</ul>
						</div>
					</div>
				</div>
			</div>

			<PlayerStatisticsSummary state={playerStatisticsState} />

			<div class="deco-panel mt-8 p-6">
				<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
					<div>
						<h2 class="deco-section-title text-lg">AI Rival Settings</h2>
						<p class="deco-text-dim text-sm">
							Choose your model provider and store an API key in this browser to enable the Gemini
							or OpenAI poker rival.
						</p>
					</div>
					<p
						id="ai-settings-feedback"
						class="deco-muted-text text-right text-xs font-semibold uppercase tracking-widest"
					>
						Stored in this browser
					</p>
				</div>

				<form id="ai-settings-form" class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2">
					<div class="col-span-full sm:col-span-1">
						<label for="ai-provider" class="deco-label block font-medium"> Model Provider </label>
						<select
							id="ai-provider"
							name="provider"
							class="deco-input mt-2 w-full px-3 py-2 text-sm"
						>
							{
								aiProviderOptions.map((provider) => (
									<option value={provider} selected={initialAiProvider === provider}>
										{providerLabels[provider]}
									</option>
								))
							}
						</select>
					</div>
					<div class="col-span-full sm:col-span-1">
						<label for="ai-model" class="deco-label block font-medium"> Model Variant </label>
						<select
							id="ai-model"
							name="model"
							class="deco-input mt-2 w-full px-3 py-2 text-sm"
							data-model-labels={JSON.stringify(modelLabels)}
						>
							{
								aiModelOptions[initialAiProvider].map((model: string) => (
									<option value={model} selected={initialAiModel === model}>
										{modelLabels[model] ?? model}
									</option>
								))
							}
						</select>
					</div>

					<div class="col-span-full space-y-2">
						<label id="api-key-label" for="api-key" class="deco-label block font-medium">
							{initialAiProvider === 'openai' ? 'OpenAI API Key' : 'Gemini API Key'}
						</label>
						<div class="flex flex-col gap-2 sm:flex-row sm:items-center">
							<div class="relative flex-1">
								<input
									id="api-key"
									name="apiKey"
									type="password"
									placeholder={initialAiProvider === 'openai' ? 'sk-...' : 'AIza...'}
									class="deco-input w-full px-3 py-2 pr-20 text-sm"
									autocomplete="off"
								/>
								<div class="absolute right-2 top-1/2 -translate-y-1/2 flex items-center gap-1">
									<button
										type="button"
										id="show-api-key"
										class="deco-icon-btn rounded p-1.5"
										title="Show API key"
										aria-label="Show API key"
										style="display: none;"
									>
										<svg
											aria-hidden="true"
											focusable="false"
											xmlns="http://www.w3.org/2000/svg"
											width="16"
											height="16"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"></path>
											<circle cx="12" cy="12" r="3"></circle>
										</svg>
									</button>
									<button
										type="button"
										id="hide-api-key"
										class="deco-icon-btn rounded p-1.5"
										title="Hide API key"
										aria-label="Hide API key"
										style="display: none;"
									>
										<svg
											aria-hidden="true"
											focusable="false"
											xmlns="http://www.w3.org/2000/svg"
											width="16"
											height="16"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<path d="M9.88 9.88a3 3 0 1 0 4.24 4.24"></path>
											<path
												d="M10.73 5.08A10.43 10.43 0 0 1 12 5c7 0 10 7 10 7a13.16 13.16 0 0 1-1.67 2.68"
											></path>
											<path
												d="M6.61 6.61A13.526 13.526 0 0 0 2 12s3 7 10 7a9.74 9.74 0 0 0 5.39-1.61"
											></path>
											<line x1="2" x2="22" y1="2" y2="22"></line>
										</svg>
									</button>
									<button
										type="button"
										id="copy-api-key"
										class="deco-icon-btn rounded p-1.5"
										title="Copy API key"
										aria-label="Copy API key"
										style="display: none;"
									>
										<svg
											aria-hidden="true"
											focusable="false"
											xmlns="http://www.w3.org/2000/svg"
											width="16"
											height="16"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
											<path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
										</svg>
									</button>
								</div>
							</div>
							<div class="flex items-center gap-2">
								<span
									id="api-key-status"
									class="deco-muted-text text-xs font-semibold uppercase tracking-widest"
								>
									Not saved
								</span>
								<button
									type="button"
									id="clear-api-key"
									class="text-xs text-[var(--deco-rose)] hover:text-[var(--deco-oxblood-bright)] underline focus:outline-none focus:ring-1 focus:ring-[var(--deco-oxblood-bright)] rounded px-1"
									style="display: none;"
								>
									Clear
								</button>
							</div>
						</div>
						<p id="api-key-help" class="deco-muted-text text-xs">
							{
								initialAiProvider === 'openai'
									? 'Required for the GPT-4o rival. The key is stored in this browser only. Switching provider replaces the active record.'
									: 'Used for Gemini Flash rivals. The key is stored in this browser only. Switching provider replaces the active record.'
							}
						</p>
					</div>

					<div class="col-span-full flex justify-end">
						<button type="submit" class="deco-btn deco-btn-primary">
							Save Rival Preferences
						</button>
					</div>
				</form>
			</div>

			<!-- Achievements Section -->
			<div class="deco-panel mt-8 p-6">
				<div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
					<div>
						<h2 class="deco-section-title text-lg">Achievements & Badges</h2>
						<p class="deco-text-dim text-sm">
							Earn badges by reaching milestones and accomplishing feats across all casino games.
						</p>
					</div>
					<div class="text-right">
						<p class="deco-stat-value text-2xl tabular-nums">
							{achievementProgress.unlocked}/{achievementProgress.total}
						</p>
						<p class="deco-eyebrow-sm">Unlocked</p>
					</div>
				</div>

				<!-- Progress Bar -->
				<div
					class="deco-progress-track mt-4 h-2 w-full rounded-full"
					role="progressbar"
					aria-label="Achievement progress"
					aria-valuemin="0"
					aria-valuemax="100"
					aria-valuenow={clampedPercentage()}
					aria-valuetext={`${clampedPercentage()}%`}
				>
					<div
						class="deco-progress-fill h-full transition-all duration-500"
						style={`width: ${clampedPercentage()}%`}
					>
					</div>
				</div>

				<!-- Achievements Grid -->
				<div class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
					{
						achievements.map((achievement) => (
							<div
								class:list={[
									'relative rounded-sm border p-4 transition-all',
									!achievement.isUnlocked && 'opacity-60',
								]}
								style={
									achievement.isUnlocked
										? 'border-color: color-mix(in srgb, var(--deco-brass) 40%, transparent); background: linear-gradient(160deg, color-mix(in srgb, var(--deco-brass) 10%, transparent), rgba(17,24,21,0.6))'
										: 'border-color: color-mix(in srgb, var(--deco-brass) 12%, transparent); background: rgba(11,15,14,0.5)'
								}
								data-testid={`achievement-${achievement.id}`}
							>
								<div class="flex items-start gap-3">
									<div
										class={`flex h-12 w-12 items-center justify-center rounded-sm text-2xl ${
											achievement.isUnlocked ? '' : 'grayscale'
										}`}
										style={
											achievement.isUnlocked
												? 'border: 1px solid color-mix(in srgb, var(--deco-brass) 40%, transparent); background: color-mix(in srgb, var(--deco-brass) 10%, transparent)'
												: 'border: 1px solid color-mix(in srgb, var(--deco-brass) 10%, transparent); background: rgba(17,24,21,0.5)'
										}
									>
										{achievement.icon}
									</div>
									<div class="flex-1 min-w-0">
										<h3
											class="font-semibold"
											style={`color: ${achievement.isUnlocked ? 'var(--deco-ivory)' : 'var(--deco-muted)'}`}
										>
											{achievement.name}
										</h3>
										<p class="deco-muted-text text-xs mt-0.5">{achievement.description}</p>
										{achievement.isUnlocked && achievement.earnedAt && (
											<p class="deco-accent-dim text-xs mt-1">
												Earned{' '}
												{new Date(achievement.earnedAt).toLocaleDateString(undefined, {
													month: 'short',
													day: 'numeric',
													year: 'numeric',
												})}
											</p>
										)}
									</div>
								</div>
								{achievement.isUnlocked && (
									<div class="absolute top-2 right-2 text-[var(--deco-brass)]">
										<svg
											aria-hidden="true"
											focusable="false"
											xmlns="http://www.w3.org/2000/svg"
											width="16"
											height="16"
											viewBox="0 0 24 24"
											fill="none"
											stroke="currentColor"
											stroke-width="2"
											stroke-linecap="round"
											stroke-linejoin="round"
										>
											<polyline points="20 6 9 17 4 12" />
										</svg>
									</div>
								)}
							</div>
						))
					}
				</div>

				{
					achievementsFetchError ? (
						<div class="mt-6 text-center py-8">
							<p style="color: var(--deco-rose)">Unable to load achievements — try again</p>
						</div>
					) : achievements.length === 0 ? (
						<div class="mt-6 text-center py-8">
							<p class="deco-text-dim">
								No achievements available yet. Start playing to earn badges!
							</p>
						</div>
					) : null
				}
			</div>
		</div>
	</section>

	<!-- Toast Notification -->
	<div
		id="toast-notification"
		class="fixed bottom-4 right-4 bg-[var(--deco-emerald)] text-[var(--deco-mint)] border border-[var(--deco-jade)]/40 px-4 py-3 rounded-lg shadow-lg flex items-center gap-2 transition-all duration-300 opacity-0 pointer-events-none translate-y-2"
		style="z-index: 9999;"
	>
		<svg
			aria-hidden="true"
			focusable="false"
			xmlns="http://www.w3.org/2000/svg"
			width="20"
			height="20"
			viewBox="0 0 24 24"
			fill="none"
			stroke="currentColor"
			stroke-width="2"
			stroke-linecap="round"
			stroke-linejoin="round"
		>
			<polyline points="20 6 9 17 4 12"></polyline>
		</svg>
		<span id="toast-message">Copied to clipboard!</span>
	</div>
</CasinoLayout>

<script>
	import { authClient } from '../lib/auth-client';
	import { AI_MODELS, AI_PROVIDERS, loadAiSettings, type AiSettings } from '../lib/ai';
	import {
		clearAiSettingsFromForm,
		populateModels,
		readCurrentAiSettings,
		saveAiSettingsFromForm,
		setFeedback,
		showToast,
	} from '../lib/profile-form-handlers';

	// Sign out handler
	const signoutBtn = document.getElementById('signout-btn');
	signoutBtn?.addEventListener('click', async () => {
		try {
			await authClient.signOut();
			window.location.href = '/signin';
		} catch (error) {
			console.error('Sign out error:', error);
		}
	});

	const stored = loadAiSettings();
	let aiState: AiSettings = stored ?? {
		provider: 'openai',
		model: AI_MODELS.openai[0],
		apiKey: '',
	};
	let isKeyRevealed = false;

	const aiForm = document.getElementById('ai-settings-form');

	// Get DOM elements
	const providerSelect = document.getElementById('ai-provider') as HTMLSelectElement | null;
	const modelSelect = document.getElementById('ai-model') as HTMLSelectElement | null;
	const apiKeyInput = document.getElementById('api-key') as HTMLInputElement | null;
	const apiKeyLabel = document.getElementById('api-key-label');
	const apiKeyStatus = document.getElementById('api-key-status');
	const apiKeyHelp = document.getElementById('api-key-help');
	const clearKeyButton = document.getElementById('clear-api-key') as HTMLButtonElement | null;
	const showKeyButton = document.getElementById('show-api-key') as HTMLButtonElement | null;
	const hideKeyButton = document.getElementById('hide-api-key') as HTMLButtonElement | null;
	const copyKeyButton = document.getElementById('copy-api-key') as HTMLButtonElement | null;
	const feedbackEl = document.getElementById('ai-settings-feedback');
	const toastEl = document.getElementById('toast-notification');
	const toastMessage = document.getElementById('toast-message');

	// Parse model labels for the provider/model controls.
	let modelLabels: Record<string, string> = {};
	if (typeof modelSelect?.dataset.modelLabels === 'string') {
		try {
			modelLabels = JSON.parse(modelSelect.dataset.modelLabels);
		} catch (error) {
			console.error('Failed to parse model labels dataset:', error);
		}
	}

	function updateApiKeyUI(): void {
		const hasKey = aiState.apiKey.length > 0;
		const isOpenAI = aiState.provider === 'openai';

		if (apiKeyLabel) {
			apiKeyLabel.textContent = isOpenAI ? 'OpenAI API Key' : 'Gemini API Key';
		}
		if (apiKeyHelp) {
			apiKeyHelp.textContent = isOpenAI
				? 'Required for the GPT-4o rival. The key is stored in this browser only. Switching provider replaces the active record.'
				: 'Used for Gemini Flash rivals. The key is stored in this browser only. Switching provider replaces the active record.';
		}
		if (apiKeyInput) {
			apiKeyInput.placeholder = isOpenAI ? 'sk-...' : 'AIza...';
			apiKeyInput.type = isKeyRevealed ? 'text' : 'password';
			if (isKeyRevealed) {
				apiKeyInput.value = aiState.apiKey;
			} else if (hasKey) {
				apiKeyInput.value = '•'.repeat(aiState.apiKey.length || 20);
				apiKeyInput.placeholder = 'Saved key (masked)';
			} else {
				apiKeyInput.value = '';
			}
		}
		if (apiKeyStatus) {
			apiKeyStatus.textContent = hasKey ? 'Saved' : 'Not saved';
		}
		if (clearKeyButton) clearKeyButton.style.display = hasKey ? 'inline-block' : 'none';
		if (showKeyButton) {
			showKeyButton.style.display = hasKey && !isKeyRevealed ? 'block' : 'none';
		}
		if (hideKeyButton) {
			hideKeyButton.style.display = hasKey && isKeyRevealed ? 'block' : 'none';
		}
		if (copyKeyButton) copyKeyButton.style.display = hasKey ? 'block' : 'none';
	}

	// Initialize provider select and populate models
	if (providerSelect) {
		providerSelect.value = aiState.provider;
		populateModels(modelSelect, aiState.provider, aiState.model, AI_MODELS, modelLabels);
		updateApiKeyUI();

		providerSelect.addEventListener('change', () => {
			const nextProvider = providerSelect.value as AiSettings['provider'];
			if (!AI_PROVIDERS.includes(nextProvider)) return;

			populateModels(modelSelect, nextProvider, AI_MODELS[nextProvider][0], AI_MODELS, modelLabels);
			aiState = {
				provider: nextProvider,
				model: modelSelect?.value ?? AI_MODELS[nextProvider][0],
				apiKey: '',
			};
			isKeyRevealed = false;
			updateApiKeyUI();
		});
	}

	// Show API key button
	if (showKeyButton) {
		showKeyButton.addEventListener('click', () => {
			isKeyRevealed = true;
			updateApiKeyUI();
		});
	}

	// Hide API key button
	if (hideKeyButton) {
		hideKeyButton.addEventListener('click', () => {
			isKeyRevealed = false;
			updateApiKeyUI();
		});
	}

	// Copy API key button
	if (copyKeyButton) {
		copyKeyButton.addEventListener('click', async () => {
			if (!aiState.apiKey) {
				showToast(toastEl, toastMessage, 'No API key saved');
				return;
			}

			try {
				await navigator.clipboard.writeText(aiState.apiKey);
				showToast(toastEl, toastMessage, 'API key copied to clipboard!');
			} catch (error) {
				console.error('Failed to copy API key:', error);
				showToast(toastEl, toastMessage, 'Failed to copy to clipboard');
			}
		});
	}

	// Clear API key button
	if (clearKeyButton) {
		clearKeyButton.addEventListener('click', () => {
			if (confirm('Are you sure you want to remove your saved API key?')) {
				clearAiSettingsFromForm();
				aiState = { ...aiState, apiKey: '' };
				isKeyRevealed = false;
				updateApiKeyUI();
				setFeedback(feedbackEl, 'API key cleared', 'success');
			}
		});
	}

	// Form submission
	aiForm?.addEventListener('submit', (event) => {
		event.preventDefault();
		if (!providerSelect || !modelSelect) return;

		const provider = providerSelect.value as AiSettings['provider'];
		if (!AI_PROVIDERS.includes(provider)) {
			setFeedback(feedbackEl, 'Could not save preferences', 'error');
			return;
		}

		setFeedback(feedbackEl, 'Saving…', 'neutral');
		try {
			const previous = readCurrentAiSettings() ?? (aiState.apiKey ? aiState : null);
			aiState = saveAiSettingsFromForm(
				provider,
				modelSelect.value,
				apiKeyInput?.value ?? '',
				previous,
			);
			isKeyRevealed = false;
			populateModels(modelSelect, aiState.provider, aiState.model, AI_MODELS, modelLabels);
			updateApiKeyUI();
			setFeedback(feedbackEl, 'Rival preferences saved', 'success');
		} catch (error) {
			console.error('Failed to save AI rival settings:', error);
			setFeedback(feedbackEl, 'Could not save preferences', 'error');
		}
	});

	updateApiKeyUI();
</script>
