---
import CasinoLayout from '../../../layouts/casino.astro';
import { getGameName } from '../../../lib/i18n/messages/games';
import { multiplayerPokerTranslator } from '../../../lib/i18n/messages/multiplayer-poker';
const user = Astro.locals.user;
if (!user) return Astro.redirect('/signin');
const locale = Astro.locals.locale;
const t = multiplayerPokerTranslator(locale);
---

<CasinoLayout title={t('pageTitle', { game: getGameName(locale, 'poker-mp') })}>
	<div class="max-w-xl mx-auto p-8 space-y-6">
		<h1 class="deco-section-title text-3xl">{getGameName(locale, 'poker-mp')}</h1>

		<section
			class="bg-[var(--deco-obsidian-2)] border border-[var(--deco-brass-dim)] p-6 rounded-lg space-y-4"
		>
			<h2 class="text-xl font-semibold text-[var(--deco-brass)]">{t('createPrivateRoom')}</h2>
			<form id="create-form" class="space-y-3">
				<label class="block text-[var(--deco-ivory-dim)]">
					{t('maxSeats')}
					<select
						name="maxSeats"
						class="ml-2 bg-[var(--deco-obsidian-2)] text-[var(--deco-ivory)] border border-[var(--deco-line)] p-1 rounded"
					>
						<option value="2">{t('headsUp')}</option>
						<option value="4" selected>4</option>
						<option value="6">6</option>
					</select>
				</label>
				<label class="block text-[var(--deco-ivory-dim)]">
					{t('smallBlind')}
					<input
						type="number"
						name="smallBlind"
						value="5"
						min="1"
						class="bg-[var(--deco-obsidian-2)] text-[var(--deco-ivory)] border border-[var(--deco-line)] p-1 rounded w-24"
					/>
				</label>
				<label class="block text-[var(--deco-ivory-dim)]">
					{t('bigBlind')}
					<input
						type="number"
						name="bigBlind"
						value="10"
						min="2"
						class="bg-[var(--deco-obsidian-2)] text-[var(--deco-ivory)] border border-[var(--deco-line)] p-1 rounded w-24"
					/>
				</label>
				<button
					type="submit"
					data-testid="create-room"
					class="bg-[var(--deco-jade)] px-4 py-2 rounded text-white font-semibold"
				>
					{t('createRoom')}
				</button>
			</form>
		</section>

		<section
			class="bg-[var(--deco-obsidian-2)] border border-[var(--deco-brass-dim)] p-6 rounded-lg space-y-4"
		>
			<h2 class="text-xl font-semibold text-[var(--deco-brass)]">{t('joinWithCode')}</h2>
			<form id="join-form" class="space-y-3">
				<input
					type="text"
					name="code"
					placeholder="MP-XXXXXX"
					pattern="MP-[A-Z0-9]{6}"
					required
					class="bg-[var(--deco-obsidian-2)] text-[var(--deco-ivory)] border border-[var(--deco-line)] p-2 rounded w-full uppercase"
					data-testid="join-code-input"
					oninput="this.value=this.value.toUpperCase()"
				/>
				<button
					type="submit"
					data-testid="join-room"
					class="bg-[var(--deco-sapphire)] px-4 py-2 rounded text-white font-semibold"
				>
					{t('join')}
				</button>
			</form>
		</section>

		<p id="status" class="text-[var(--deco-oxblood-bright)] min-h-6" data-testid="status"></p>
	</div>
</CasinoLayout>

<script>
	import { getDocumentLocale } from '../../../lib/i18n/locale';
	import { multiplayerPokerTranslator } from '../../../lib/i18n/messages/multiplayer-poker';

	const locale = getDocumentLocale(document);
	const t = multiplayerPokerTranslator(locale);
	const status = document.getElementById('status') as HTMLElement;

	// Lobby errors from the create-room API arrive as stable codes; map them to
	// localized copy instead of rendering the server's English text.
	const CREATE_ERROR_KEYS: Record<string, Parameters<typeof t>[0]> = {
		INVALID_CONFIG: 'errorInvalidConfig',
		DO_UNAVAILABLE: 'errorServiceUnavailable',
		CODE_GENERATION_FAILED: 'errorCodeGeneration',
	};

	document.getElementById('create-form')!.addEventListener('submit', async (e) => {
		e.preventDefault();
		const fd = new FormData(e.target as HTMLFormElement);
		const sb = Number(fd.get('smallBlind'));
		const bb = Number(fd.get('bigBlind'));
		if (bb < sb * 2) {
			status.textContent = t('errorBigBlindRatio');
			return;
		}
		let res: Response;
		try {
			res = await fetch('/api/mp/rooms', {
				method: 'POST',
				headers: { 'content-type': 'application/json' },
				body: JSON.stringify({
					maxSeats: Number(fd.get('maxSeats')),
					smallBlind: sb,
					bigBlind: bb,
				}),
			});
		} catch {
			status.textContent = t('errorNetwork');
			return;
		}
		let json: { code?: string; error?: string };
		try {
			json = await res.json();
		} catch {
			status.textContent = t('errorUnexpectedResponse', { status: String(res.status) });
			return;
		}
		if (res.ok && json.code) location.href = `/games/poker-mp/${json.code}`;
		else
			status.textContent = json.error
				? t(CREATE_ERROR_KEYS[json.error] ?? 'errorFailed')
				: t('errorFailed');
	});

	document.getElementById('join-form')!.addEventListener('submit', (e) => {
		e.preventDefault();
		const fd = new FormData(e.target as HTMLFormElement);
		const code = String(fd.get('code')).toUpperCase();
		location.href = `/games/poker-mp/${code}`;
	});
</script>
