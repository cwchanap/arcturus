---
import CasinoLayout from '../../layouts/casino.astro';
import { GAME_TYPES, GAME_TYPE_ICONS, GAME_TYPE_LABELS } from '../../lib/game-stats/constants';

const session = Astro.locals.session;
if (!session) return Astro.redirect('/signin');

Astro.response.headers.set('Cache-Control', 'private, no-store');
---

<CasinoLayout title="Player Statistics - Arcturus Casino">
	<section class="deco-atmosphere relative overflow-hidden">
		<main
			id="player-statistics-root"
			class="relative mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8"
			aria-busy="true"
		>
			<header class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
				<div>
					<p class="deco-eyebrow-sm">All-time casual play</p>
					<h1
						class="deco-section-title mt-2 text-3xl sm:text-4xl"
						data-statistics-heading
						tabindex="-1"
					>
						Player Statistics
					</h1>
				</div>
				<a href="/profile" class="deco-link">Back to profile</a>
			</header>

			<section
				class="mt-8"
				data-statistics-loading
				role="status"
				aria-label="Loading player statistics"
			>
				<span class="sr-only">Loading player statistics</span>
				<div class="deco-panel p-6" aria-hidden="true">
					<div class="statistics-skeleton h-3 w-28 bg-white/10"></div>
					<div class="statistics-skeleton mt-3 h-8 w-48 bg-white/10"></div>
					<div class="mt-6 grid grid-cols-2 gap-4 lg:grid-cols-4">
						{
							Array.from({ length: 4 }, (_, index) => (
								<div class="space-y-2">
									<div
										class="statistics-skeleton h-3 w-20 bg-white/10"
										aria-label={`Summary metric ${index + 1} loading`}
									/>
									<div class="statistics-skeleton h-7 w-24 bg-white/10" />
								</div>
							))
						}
					</div>
				</div>

				<div class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3">
					{
						GAME_TYPES.map((gameType) => (
							<article
								class="deco-panel min-h-80 p-5 sm:p-6"
								aria-label={`${GAME_TYPE_LABELS[gameType]} statistics loading`}
							>
								<div class="flex items-center gap-3">
									<span class="text-3xl leading-none" aria-hidden="true">
										{GAME_TYPE_ICONS[gameType]}
									</span>
									<div class="min-w-0 flex-1">
										<div class="statistics-skeleton h-5 w-32 bg-white/10" />
										<div class="statistics-skeleton mt-2 h-3 w-20 bg-white/10" />
									</div>
								</div>
								<div class="mt-6 grid grid-cols-3 gap-3" aria-hidden="true">
									<div class="statistics-skeleton h-14 bg-white/10" />
									<div class="statistics-skeleton h-14 bg-white/10" />
									<div class="statistics-skeleton h-14 bg-white/10" />
								</div>
								<div class="mt-5 grid grid-cols-2 gap-3" aria-hidden="true">
									<div class="statistics-skeleton h-12 bg-white/10" />
									<div class="statistics-skeleton h-12 bg-white/10" />
									<div class="statistics-skeleton h-12 bg-white/10" />
									<div class="statistics-skeleton h-12 bg-white/10" />
								</div>
							</article>
						))
					}
				</div>
			</section>

			<section class="deco-panel mt-8 p-6" data-statistics-error role="alert" tabindex="-1" hidden>
				<h2 class="deco-section-title text-xl">Player statistics could not be loaded.</h2>
				<p class="mt-2 text-[var(--deco-ivory-dim)]">Check your connection and try again.</p>
				<button type="button" class="deco-btn deco-btn-primary mt-5" data-statistics-retry>
					Try again
				</button>
			</section>

			<div class="mt-8" data-statistics-content hidden>
				<section class="deco-panel p-6" aria-labelledby="overall-statistics-heading">
					<p class="deco-eyebrow-sm">All games</p>
					<h2 id="overall-statistics-heading" class="deco-section-title mt-1 text-xl">
						Overall Performance
					</h2>
					<div class="mt-6" data-statistics-summary></div>
				</section>

				<aside class="deco-panel mt-6 p-5" data-statistics-empty hidden>
					<p class="deco-section-title text-lg">Start playing to build your statistics.</p>
				</aside>

				<section
					class="mt-6 grid grid-cols-1 gap-5 md:grid-cols-2 xl:grid-cols-3"
					aria-label="Statistics by game"
					data-statistics-games
				>
				</section>
			</div>

			<noscript>
				<style>
					[data-statistics-loading] {
						display: none !important;
					}
				</style>
				<p class="deco-panel mt-6 p-4">
					JavaScript is required to load detailed player statistics.
				</p>
			</noscript>
		</main>
	</section>
</CasinoLayout>

<style>
	.statistics-skeleton {
		animation: statistics-pulse 1.5s ease-in-out infinite;
	}

	@keyframes statistics-pulse {
		0%,
		100% {
			opacity: 0.45;
		}
		50% {
			opacity: 0.85;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.statistics-skeleton {
			animation: none;
		}
	}
</style>

<script>
	import { initPlayerStatisticsClient } from '../../lib/profile-statistics-client';

	const root = document.querySelector<HTMLElement>('#player-statistics-root');
	if (root) void initPlayerStatisticsClient(root);
</script>
