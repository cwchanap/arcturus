---
import CasinoLayout from '../../layouts/casino.astro';
import PokerChip from '../../components/PokerChip.astro';
import { createPublicGameSession } from '../../lib/public-game-session';
import { formatChips } from '../../lib/i18n/messages/common';

const user = Astro.locals.user;
const gameSession = createPublicGameSession(user);
const initialBalance = gameSession.initialBalance;
const locale = Astro.locals.locale;
// Opaque per-user surrogate: 'anonymous' for guests, a non-reversible hash for
// authenticated users. The raw account id is never rendered into the DOM.
const clientUserId = gameSession.clientUserId;
---

<CasinoLayout title="Craps - Arcturus Casino">
	<div
		id="craps-root"
		data-user-id={clientUserId}
		data-guest-mode={gameSession.guestModeValue}
		data-initial-balance={initialBalance}
		class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8"
	>
		<!-- Header -->
		<div class="flex items-center justify-between mb-6">
			<div>
				<a
					href="/games"
					class="text-[var(--deco-muted)] hover:text-[var(--deco-brass)] transition-colors mb-2 inline-block"
				>
					← Back to Games
				</a>
				<h1 class="deco-section-title text-4xl">Craps</h1>
			</div>
			<div
				class="bg-[var(--deco-obsidian-2)] px-6 py-3 rounded-lg border border-[var(--deco-brass-dim)]"
			>
				<div class="text-xs text-[var(--deco-muted)] mb-1">{gameSession.balanceLabel}</div>
				<div class="text-2xl font-bold text-[var(--deco-brass)]" id="chip-balance">
					{formatChips(initialBalance, locale)}
				</div>
			</div>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-4 gap-6">
			<!-- Main Game Area (3 cols) -->
			<div class="lg:col-span-3 space-y-4">
				<!-- Dice + Status Bar -->
				<div
					class="bg-[var(--deco-obsidian-2)] rounded-xl border border-[var(--deco-line)] p-4 flex items-center gap-6"
				>
					<div class="flex gap-4 items-center">
						<div class="die-display" id="die1" data-value="0">
							<svg viewBox="0 0 60 60" class="w-14 h-14" aria-hidden="true">
								<rect width="60" height="60" rx="10" class="die-face"></rect>
								<g class="die-dots" id="die1-dots"></g>
							</svg>
						</div>
						<div class="die-display" id="die2" data-value="0">
							<svg viewBox="0 0 60 60" class="w-14 h-14" aria-hidden="true">
								<rect width="60" height="60" rx="10" class="die-face"></rect>
								<g class="die-dots" id="die2-dots"></g>
							</svg>
						</div>
						<div class="text-center">
							<div class="text-[var(--deco-muted)] text-xs uppercase tracking-wider">Total</div>
							<div class="text-3xl font-bold text-[var(--deco-ivory)]" id="roll-total">—</div>
						</div>
					</div>

					<div class="flex-1 border-l border-[var(--deco-line)] pl-4">
						<div class="flex items-center gap-3 mb-1">
							<span
								id="phase-badge"
								class="px-2 py-0.5 rounded text-xs font-bold bg-[var(--deco-obsidian-3)] text-[var(--deco-sapphire)] uppercase tracking-wider"
							>
								Come-Out
							</span>
							<span
								id="point-badge"
								class="hidden px-2 py-0.5 rounded text-xs font-bold bg-[var(--deco-obsidian-3)] text-[var(--deco-brass)]"
							>
								Point: —
							</span>
						</div>
						<div id="game-message" class="text-[var(--deco-ivory-dim)] text-sm">
							Place your bets, then roll!
						</div>
						<div
							id="settlement-recovery"
							class="hidden mt-2 flex flex-wrap gap-2"
							data-testid="settlement-recovery"
						>
							<button
								id="btn-retry-settlement"
								type="button"
								class="btn-gold px-3 py-1 rounded text-xs font-bold"
								data-testid="retry-settlement"
							>
								Retry settlement
							</button>
							<button
								id="btn-reset-settlement"
								type="button"
								class="px-3 py-1 rounded text-xs border border-[var(--deco-line)]"
								data-testid="reset-settlement"
							>
								Reset settlement
							</button>
						</div>
					</div>

					<div>
						<button
							id="roll-button"
							data-testid="roll-button"
							disabled
							class="btn-gold px-6 py-3 rounded-xl font-bold text-lg disabled:opacity-40 disabled:cursor-not-allowed min-w-[110px]"
						>
							ROLL
						</button>
					</div>
				</div>

				<!-- Craps Table -->
				<div class="craps-table rounded-2xl p-4 space-y-3">
					<!-- Pass Line / Don't Pass -->
					<div class="grid grid-cols-2 gap-3">
						<div
							data-bet-type="passLine"
							class="bet-zone pass-zone cursor-pointer select-none rounded-lg p-3 text-center transition-all"
						>
							<div class="text-[var(--deco-ivory)] font-bold text-sm uppercase tracking-wider">
								Pass Line
							</div>
							<div class="text-[var(--deco-muted)] text-xs">Pays 1:1</div>
							<div class="bet-amount text-[var(--deco-brass)] font-bold mt-1 h-5 text-sm"></div>
						</div>
						<div
							data-bet-type="dontPass"
							class="bet-zone dont-zone cursor-pointer select-none rounded-lg p-3 text-center transition-all"
						>
							<div class="text-[var(--deco-ivory)] font-bold text-sm uppercase tracking-wider">
								Don't Pass Bar
							</div>
							<div class="text-[var(--deco-muted)] text-xs">Pays 1:1 (Bar 12)</div>
							<div class="bet-amount text-[var(--deco-brass)] font-bold mt-1 h-5 text-sm"></div>
						</div>
					</div>

					<!-- Pass Odds / Don't Pass Odds (shown only in point phase) -->
					<div id="odds-row" class="hidden grid-cols-2 gap-3">
						<div
							data-bet-type="passLineOdds"
							class="bet-zone odds-zone cursor-pointer select-none rounded-lg p-3 text-center transition-all"
						>
							<div class="text-[var(--deco-jade)] font-bold text-sm uppercase tracking-wider">
								Pass Odds
							</div>
							<div class="text-[var(--deco-muted)] text-xs">0% house edge · 2x max</div>
							<div class="bet-amount text-[var(--deco-brass)] font-bold mt-1 h-5 text-sm"></div>
						</div>
						<div
							data-bet-type="dontPassOdds"
							class="bet-zone odds-zone cursor-pointer select-none rounded-lg p-3 text-center transition-all"
						>
							<div class="text-[var(--deco-jade)] font-bold text-sm uppercase tracking-wider">
								Don't Pass Odds
							</div>
							<div class="text-[var(--deco-muted)] text-xs">0% house edge · 2x max</div>
							<div class="bet-amount text-[var(--deco-brass)] font-bold mt-1 h-5 text-sm"></div>
						</div>
					</div>

					<!-- Number Row: Place / Come bets per number -->
					<div class="grid grid-cols-6 gap-2">
						{
							[4, 5, 6, 8, 9, 10].map((n) => (
								<div class="number-box rounded-lg p-2 text-center" data-number={n}>
									<div class="text-[var(--deco-ivory)] font-bold text-sm">
										{n === 6 ? 'SIX' : n === 8 ? 'EIGHT' : n}
									</div>
									<div
										data-bet-type={`place${n}`}
										class="bet-zone place-zone cursor-pointer mt-1 rounded p-1 text-center"
									>
										<div class="text-[var(--deco-muted)] text-xs">Place</div>
										<div class="bet-amount text-[var(--deco-brass)] font-bold h-4 text-xs" />
									</div>
									<div id={`come-${n}`} class="come-bet-display mt-1 hidden">
										<div class="text-[var(--deco-sapphire)] text-xs font-bold come-display-amount" />
									</div>
									<div class="flex gap-1 mt-1 justify-center">
										<div
											data-bet-type={`buy${n}`}
											class="bet-zone buy-zone cursor-pointer rounded px-1 py-0.5 text-xs text-[var(--deco-jade)] hover:bg-[var(--deco-emerald-deep)]"
										>
											B
										</div>
										<div
											data-bet-type={`lay${n}`}
											class="bet-zone lay-zone cursor-pointer rounded px-1 py-0.5 text-xs text-[var(--deco-oxblood-bright)] hover:bg-[var(--deco-oxblood)]"
										>
											L
										</div>
									</div>
								</div>
							))
						}
					</div>

					<!-- Come / Don't Come / Field -->
					<div class="grid grid-cols-3 gap-3">
						<div
							data-bet-type="come"
							class="bet-zone come-zone cursor-pointer select-none rounded-lg p-3 text-center transition-all"
						>
							<div class="text-[var(--deco-sapphire)] font-bold text-sm uppercase tracking-wider">
								Come
							</div>
							<div class="text-[var(--deco-muted)] text-xs">Pays 1:1</div>
							<div class="bet-amount text-[var(--deco-brass)] font-bold mt-1 h-5 text-sm"></div>
						</div>
						<div
							data-bet-type="field"
							class="bet-zone field-zone cursor-pointer select-none rounded-lg p-3 text-center transition-all"
						>
							<div class="text-[var(--deco-amethyst)] font-bold text-sm uppercase tracking-wider">
								Field
							</div>
							<div class="text-[var(--deco-muted)] text-xs">3,4,9,10,11 · 2× on 2 · 3× on 12</div>
							<div class="bet-amount text-[var(--deco-brass)] font-bold mt-1 h-5 text-sm"></div>
						</div>
						<div
							data-bet-type="dontCome"
							class="bet-zone dont-zone cursor-pointer select-none rounded-lg p-3 text-center transition-all"
						>
							<div
								class="text-[var(--deco-brass-bright)] font-bold text-sm uppercase tracking-wider"
							>
								Don't Come
							</div>
							<div class="text-[var(--deco-muted)] text-xs">Pays 1:1 (Bar 12)</div>
							<div class="bet-amount text-[var(--deco-brass)] font-bold mt-1 h-5 text-sm"></div>
						</div>
					</div>

					<!-- Big 6 / Big 8 -->
					<div class="grid grid-cols-2 gap-3">
						<div
							data-bet-type="big6"
							class="bet-zone place-zone cursor-pointer select-none rounded-lg p-3 text-center"
						>
							<div class="text-[var(--deco-ivory-dim)] font-bold text-sm uppercase tracking-wider">
								Big 6
							</div>
							<div class="text-[var(--deco-muted)] text-xs">Pays 1:1</div>
							<div class="bet-amount text-[var(--deco-brass)] font-bold mt-1 h-5 text-sm"></div>
						</div>
						<div
							data-bet-type="big8"
							class="bet-zone place-zone cursor-pointer select-none rounded-lg p-3 text-center"
						>
							<div class="text-[var(--deco-ivory-dim)] font-bold text-sm uppercase tracking-wider">
								Big 8
							</div>
							<div class="text-[var(--deco-muted)] text-xs">Pays 1:1</div>
							<div class="bet-amount text-[var(--deco-brass)] font-bold mt-1 h-5 text-sm"></div>
						</div>
					</div>

					<!-- Hardways Row -->
					<div class="border-t border-[var(--deco-line)] pt-3">
						<div class="text-[var(--deco-muted)] text-xs uppercase tracking-wider mb-2 text-center">
							Hardways (off during come-out)
						</div>
						<div class="grid grid-cols-4 gap-2">
							{
								[
									{ type: 'hard4', label: 'Hard 4', pays: '7:1' },
									{ type: 'hard6', label: 'Hard 6', pays: '9:1' },
									{ type: 'hard8', label: 'Hard 8', pays: '9:1' },
									{ type: 'hard10', label: 'Hard 10', pays: '7:1' },
								].map((h) => (
									<div
										data-bet-type={h.type}
										class="bet-zone hardway-zone cursor-pointer select-none rounded-lg p-2 text-center transition-all"
									>
										<div class="text-[var(--deco-brass-bright)] font-bold text-xs">{h.label}</div>
										<div class="text-[var(--deco-muted)] text-xs">{h.pays}</div>
										<div class="bet-amount text-[var(--deco-brass)] font-bold mt-1 h-4 text-xs" />
									</div>
								))
							}
						</div>
					</div>

					<!-- Proposition Bets -->
					<div class="border-t border-[var(--deco-line)] pt-3">
						<div class="text-[var(--deco-muted)] text-xs uppercase tracking-wider mb-2 text-center">
							Proposition Bets (one-roll)
						</div>
						<div class="grid grid-cols-7 gap-1.5">
							{
								[
									{ type: 'any7', label: 'Any 7', pays: '4:1' },
									{ type: 'anyCraps', label: 'Any Craps', pays: '7:1' },
									{ type: 'aces', label: 'Aces (2)', pays: '30:1' },
									{ type: 'aceDeuce', label: 'Ace-Deuce', pays: '15:1' },
									{ type: 'yo', label: 'Yo (11)', pays: '15:1' },
									{ type: 'boxcars', label: 'Boxcars', pays: '30:1' },
									{ type: 'ce', label: 'C & E', pays: '3/7:1' },
								].map((p) => (
									<div
										data-bet-type={p.type}
										class="bet-zone prop-zone cursor-pointer select-none rounded-lg p-1.5 text-center transition-all"
									>
										<div class="text-[var(--deco-oxblood-bright)] font-bold text-xs leading-tight">
											{p.label}
										</div>
										<div class="text-[var(--deco-muted)] text-xs">{p.pays}</div>
										<div class="bet-amount text-[var(--deco-brass)] font-bold mt-0.5 h-4 text-xs" />
									</div>
								))
							}
						</div>
					</div>
				</div><!-- /craps-table -->

				<!-- Chip Selection + Controls -->
				<div class="bg-[var(--deco-obsidian-2)] rounded-xl p-4 border border-[var(--deco-line)]">
					<div class="flex flex-wrap items-center justify-between gap-4">
						<div class="flex gap-2 flex-wrap">
							{
								[
									{ amount: 5, color: 'gold' },
									{ amount: 25, color: 'red' },
									{ amount: 50, color: 'blue' },
									{ amount: 100, color: 'green' },
									{ amount: 500, color: 'black' },
								].map((c) => (
									<button
										class="chip-select hover:scale-110 transition-transform"
										data-amount={c.amount}
										data-testid={`chip-${c.amount}`}
									>
										<PokerChip
											value={c.amount}
											color={c.color as 'red' | 'blue' | 'green' | 'black' | 'gold'}
										/>
									</button>
								))
							}
						</div>
						<div class="flex items-center gap-3">
							<div>
								<span class="text-[var(--deco-muted)] text-sm">Total Bet:</span>
								<span
									id="total-bet"
									data-testid="total-bet"
									class="text-[var(--deco-brass)] font-bold ml-1">$0</span
								>
							</div>
							<button
								id="clear-bets-button"
								data-testid="clear-bets-button"
								class="px-3 py-2 bg-[var(--deco-obsidian-3)] hover:bg-[var(--deco-line)] text-[var(--deco-ivory)] rounded-lg text-sm transition-colors"
							>
								Clear Bets
							</button>
						</div>
					</div>
				</div>
			</div><!-- /main game area -->

			<!-- Sidebar (1 col) -->
			<div class="space-y-4">
				<!-- Roll History -->
				<div class="bg-[var(--deco-obsidian-2)] rounded-xl p-4 border border-[var(--deco-line)]">
					<h3 class="text-xs font-bold text-[var(--deco-muted)] uppercase tracking-wider mb-3">
						Roll History
					</h3>
					<div
						id="roll-history"
						data-testid="roll-history"
						class="flex flex-wrap gap-1.5 min-h-[40px]"
					>
						<span class="roll-history-placeholder text-[var(--deco-muted)] text-xs"
							>No rolls yet</span
						>
					</div>
				</div>

				<!-- Active Bets -->
				<div class="bg-[var(--deco-obsidian-2)] rounded-xl p-4 border border-[var(--deco-line)]">
					<h3 class="text-xs font-bold text-[var(--deco-muted)] uppercase tracking-wider mb-3">
						Active Bets
					</h3>
					<div id="active-bets" data-testid="active-bets" class="space-y-1.5 min-h-[40px]">
						<span class="text-[var(--deco-muted)] text-xs">No bets placed</span>
					</div>
				</div>

				<!-- Come Bet Odds -->
				<div
					id="come-odds-panel"
					data-testid="come-odds-panel"
					class="hidden bg-[var(--deco-obsidian-2)] rounded-xl p-4 border border-[var(--deco-line)]"
				>
					<h3 class="text-xs font-bold text-[var(--deco-sapphire)] uppercase tracking-wider mb-3">
						Come Bet Odds
					</h3>
					<div id="come-odds-list" data-testid="come-odds-list" class="space-y-2"></div>
					<p class="text-[var(--deco-muted)] text-xs mt-2">Click to add 2× odds (0% edge)</p>
				</div>

				<!-- Payouts Reference -->
				<div class="bg-[var(--deco-obsidian-2)] rounded-xl p-4 border border-[var(--deco-line)]">
					<h3 class="text-xs font-bold text-[var(--deco-muted)] uppercase tracking-wider mb-3">
						Payouts
					</h3>
					<div class="space-y-1 text-xs">
						<div class="flex justify-between">
							<span class="text-[var(--deco-ivory-dim)]">Pass/Come</span><span
								class="text-[var(--deco-muted)]">1:1</span
							>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--deco-ivory-dim)]">Odds (4/10)</span><span
								class="text-[var(--deco-muted)]">2:1</span
							>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--deco-ivory-dim)]">Odds (5/9)</span><span
								class="text-[var(--deco-muted)]">3:2</span
							>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--deco-ivory-dim)]">Odds (6/8)</span><span
								class="text-[var(--deco-muted)]">6:5</span
							>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--deco-ivory-dim)]">Place 6/8</span><span
								class="text-[var(--deco-muted)]">7:6</span
							>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--deco-ivory-dim)]">Place 5/9</span><span
								class="text-[var(--deco-muted)]">7:5</span
							>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--deco-ivory-dim)]">Place 4/10</span><span
								class="text-[var(--deco-muted)]">9:5</span
							>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--deco-ivory-dim)]">Hard 6/8</span><span
								class="text-[var(--deco-muted)]">9:1</span
							>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--deco-ivory-dim)]">Hard 4/10</span><span
								class="text-[var(--deco-muted)]">7:1</span
							>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--deco-ivory-dim)]">Any 7</span><span
								class="text-[var(--deco-muted)]">4:1</span
							>
						</div>
						<div class="flex justify-between">
							<span class="text-[var(--deco-ivory-dim)]">Yo (11)</span><span
								class="text-[var(--deco-muted)]">15:1</span
							>
						</div>
					</div>
				</div>

				<!-- LLM Advisor -->
				<div class="bg-[var(--deco-obsidian-2)] rounded-xl p-4 border border-[var(--deco-line)]">
					<div class="flex items-center justify-between mb-3">
						<h3 class="text-xs font-bold text-[var(--deco-muted)] uppercase tracking-wider">
							AI Advisor
						</h3>
						<button
							id="llm-advice-btn"
							data-testid="llm-advice-btn"
							disabled={gameSession.isGuest}
							class="px-3 py-1 bg-[var(--deco-obsidian-3)] hover:bg-[var(--deco-line)] text-[var(--deco-brass)] rounded text-xs transition-colors border border-[var(--deco-brass-dim)]"
						>
							Ask
						</button>
					</div>
					<div
						id="llm-advice"
						class="text-[var(--deco-muted)] text-xs leading-relaxed min-h-[48px]"
					>
						{
							gameSession.isGuest
								? 'Sign in to use browser-local AI advice.'
								: 'Configure AI in your profile, then ask for advice.'
						}
					</div>
				</div>
			</div><!-- /sidebar -->
		</div><!-- /grid -->

		<!-- Insufficient Chips Overlay -->
		<div
			id="insufficient-overlay"
			class="fixed inset-0 bg-[var(--deco-obsidian)] backdrop-blur-sm z-50 items-center justify-center hidden"
		>
			<div
				class="bg-[var(--deco-obsidian-2)] rounded-xl p-8 border border-[var(--deco-oxblood)] max-w-md text-center"
			>
				<div class="text-5xl mb-4">💸</div>
				<h2 class="text-2xl font-bold text-[var(--deco-ivory)] mb-2">Insufficient Chips</h2>
				<p class="text-[var(--deco-muted)] mb-6">You don't have enough chips to continue.</p>
				<a href="/games" class="btn-gold px-8 py-3 rounded-lg font-bold inline-block"
					>Return to Lobby</a
				>
			</div>
		</div>

		<!-- Achievement Toast -->
		<div
			id="achievement-toast"
			data-testid="achievement-toast"
			role="status"
			aria-live="polite"
			aria-atomic="true"
			class="fixed bottom-4 right-4 bg-linear-to-r from-[var(--deco-brass-bright)] to-[var(--deco-brass)] text-[var(--deco-obsidian)] px-5 py-4 rounded-xl shadow-2xl flex items-center gap-3 transition-all duration-300 opacity-0 pointer-events-none translate-y-4"
			style="z-index: 9999;"
		>
			<span id="achievement-icon" data-testid="achievement-icon" class="text-3xl">🏆</span>
			<div>
				<p class="text-xs font-semibold uppercase tracking-wider opacity-80">
					Achievement Unlocked
				</p>
				<p id="achievement-name" data-testid="achievement-name" class="font-bold text-lg">
					Achievement Name
				</p>
			</div>
		</div>
	</div><!-- /craps-root -->
</CasinoLayout>

<style>
