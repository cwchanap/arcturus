---
import CasinoLayout from '../layouts/casino.astro';
import GameCard from '../components/GameCard.astro';
import Button from '../components/Button.astro';
import DecoDivider from '../components/DecoDivider.astro';
import DecoIcon from '../components/DecoIcon.astro';
import { formatWholeNumber } from '../lib/formatting';
import { formatChips, SHELL_MESSAGES } from '../lib/i18n/messages/common';
import { homeTranslator } from '../lib/i18n/messages/home';
import type { GameNameKey } from '../lib/i18n/messages/games';
import { createTranslator } from '../lib/i18n/translate';

const locale = Astro.locals.locale;
const user = Astro.locals.user;
const t = homeTranslator(locale);
const shell = createTranslator(SHELL_MESSAGES, locale);

interface HomeGame {
	gameKey: GameNameKey;
	emblem: 'cards' | 'dice' | 'wheel' | 'spark';
	players: number;
	minBet: number;
	href: string;
	featured?: boolean;
	icon?: string;
}

// Game titles resolve through getGameName() inside GameCard; only stable
// GameNameKeys live here.
const games: HomeGame[] = [
	{
		gameKey: 'poker',
		emblem: 'cards' as const,
		players: 1247,
		minBet: 10,
		href: '/games/poker',
		featured: true,
	},
	{
		gameKey: 'poker-mp',
		emblem: 'cards' as const,
		players: 0,
		minBet: 10,
		href: '/games/poker-mp',
		featured: true,
	},
	{
		gameKey: 'video-poker',
		emblem: 'cards' as const,
		players: 0,
		minBet: 1,
		href: '/games/video-poker',
	},
	{
		gameKey: 'blackjack',
		emblem: 'cards' as const,
		players: 892,
		minBet: 5,
		href: '/games/blackjack',
		featured: true,
	},
	{
		gameKey: 'daily-challenge',
		emblem: 'cards' as const,
		players: 0,
		minBet: 10,
		href: '/games/daily-challenge',
		featured: true,
	},
	{
		gameKey: 'roulette',
		emblem: 'wheel' as const,
		players: 654,
		minBet: 1,
		href: '/games/roulette',
	},
	{
		gameKey: 'baccarat',
		emblem: 'cards' as const,
		players: 432,
		minBet: 10,
		href: '/games/baccarat',
		featured: true,
	},
	{
		gameKey: 'craps',
		emblem: 'dice' as const,
		players: 321,
		minBet: 5,
		href: '/games/craps',
		featured: true,
	},
	{
		gameKey: 'slots',
		emblem: 'spark' as const,
		players: 2134,
		minBet: 1,
		href: '/games/slots',
		featured: true,
	},
	{
		gameKey: 'keno',
		emblem: 'spark' as const,
		players: 0,
		minBet: 1,
		href: '/games/keno',
	},
	{
		gameKey: 'sic-bo',
		emblem: 'dice' as const,
		players: 0,
		minBet: 1,
		href: '/games/sic-bo',
	},
	{
		gameKey: 'three-card-showdown',
		emblem: 'cards' as const,
		players: 0,
		minBet: 1,
		href: '/games/three-card-showdown',
	},
	{
		gameKey: 'pai-gow-poker',
		emblem: 'cards' as const,
		icon: '☯️',
		players: 0,
		minBet: 5,
		href: '/games/pai-gow-poker',
	},
];

const featuredGames = games.filter((game) => game.featured);

const features = [
	{
		icon: 'chip' as const,
		title: t('featureNoMoneyTitle'),
		body: t('featureNoMoneyBody'),
	},
	{
		icon: 'star' as const,
		title: t('featureUnlimitedTitle'),
		body: t('featureUnlimitedBody'),
	},
	{
		icon: 'trophy' as const,
		title: t('featureSharpenTitle'),
		body: t('featureSharpenBody'),
	},
];
---

<CasinoLayout title={t('pageTitle')}>
	<!-- Hero -->
	<section class="deco-atmosphere deco-grain relative overflow-hidden">
		<!-- Sunburst motif behind the headline -->
		<div
			class="pointer-events-none absolute inset-0 flex items-start justify-center opacity-[0.06]"
		>
			<svg
				width="900"
				height="900"
				viewBox="0 0 200 200"
				class="mt-[-120px]"
				fill="none"
				stroke="var(--deco-brass)"
				stroke-width="0.4"
				aria-hidden="true"
			>
				{
					Array.from({ length: 48 }).map((_, i) => {
						const a = (i / 48) * Math.PI * 2;
						return (
							<line x1="100" y1="100" x2={100 + Math.cos(a) * 130} y2={100 + Math.sin(a) * 130} />
						);
					})
				}
			</svg>
		</div>

		<div class="relative mx-auto max-w-5xl px-4 py-24 text-center sm:px-6 lg:px-8 lg:py-32">
			<p class="deco-section-eyebrow mb-6">{t('heroEyebrow')}</p>
			<!-- Translated copy from our own dictionary; keeps the <em> order per locale. -->
			<h1 class="deco-display mx-auto max-w-4xl text-5xl md:text-7xl" set:html={t('heroHeading')} />
			<div class="mx-auto my-8 max-w-xs">
				<DecoDivider />
			</div>
			<p class="deco-body-text mx-auto mb-10 max-w-2xl text-lg md:text-xl">
				{t('heroBody')}
			</p>

			{
				!user ? (
					<div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
						<Button href="/signin" variant="primary">
							{t('ctaJoinFree', { chips: formatChips(10_000, locale) })}
						</Button>
						<Button href="/signin" variant="outline">
							{shell('signIn')}
						</Button>
					</div>
				) : (
					<div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
						<Button href="#games" variant="primary">
							{t('ctaPlayNow')}
						</Button>
						<Button href="/missions" variant="outline">
							{shell('missions')}
						</Button>
						<Button href="/profile" variant="outline">
							{t('ctaDashboard')}
						</Button>
					</div>
				)
			}

			<div class="mx-auto mt-16 grid max-w-3xl grid-cols-1 gap-px overflow-hidden sm:grid-cols-3">
				<div class="deco-panel deco-frame px-6 py-8">
					<div class="deco-stat-value text-4xl">100%</div>
					<div class="deco-stat-label mt-2">{t('statFreeToPlay')}</div>
				</div>
				<div class="deco-panel deco-frame px-6 py-8">
					<div class="deco-stat-value text-4xl tabular-nums">
						{formatWholeNumber(5680, locale)}+
					</div>
					<div class="deco-stat-label mt-2">{t('statPlayersOnline')}</div>
				</div>
				<div class="deco-panel deco-frame px-6 py-8">
					<div class="deco-stat-value text-4xl">{formatWholeNumber(10_000, locale)}</div>
					<div class="deco-stat-label mt-2">{t('statStartingChips')}</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Games -->
	<section id="games" class="mx-auto max-w-7xl space-y-20 px-4 py-24 sm:px-6 lg:px-8">
		<div class="text-center">
			<p class="deco-section-eyebrow mb-4">{t('floorEyebrow')}</p>
			<h2 class="deco-section-title text-4xl">{t('featuredTables')}</h2>
			<div class="mx-auto mt-6 max-w-sm">
				<DecoDivider />
			</div>
		</div>

		<div class="grid grid-cols-1 gap-8 md:grid-cols-3">
			{featuredGames.map((game) => <GameCard {...game} />)}
		</div>

		<div class="space-y-10">
			<div>
				<p class="deco-section-eyebrow mb-3">{t('lineupEyebrow')}</p>
				<h3 class="deco-section-title text-3xl">{shell('allGames')}</h3>
				<p class="deco-body-text mt-3 max-w-2xl">
					{t('lineupBody')}
				</p>
			</div>
			<div class="grid grid-cols-1 gap-8 md:grid-cols-3">
				{games.map((game) => <GameCard {...game} />)}
			</div>
		</div>

		<!-- Welcome bonus -->
		<div
			class="deco-panel deco-frame deco-grain relative overflow-hidden px-8 py-14 text-center md:px-12"
		>
			<p class="deco-section-eyebrow mb-4">{t('houseEyebrow')}</p>
			<h3 class="deco-section-title text-3xl md:text-4xl">{t('houseHeading')}</h3>
			<p class="deco-body-text mx-auto mt-4 max-w-xl">
				{t('houseBody')}
			</p>
			<div class="mt-8 flex justify-center">
				<Button href="/missions" variant="primary">{t('ctaClaimBonus')}</Button>
			</div>
		</div>
	</section>

	<!-- Why Arcturus -->
	<section class="deco-atmosphere border-y border-[var(--deco-brass)]/15">
		<div class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
			<div class="mb-16 text-center">
				<p class="deco-section-eyebrow mb-4">{t('differenceEyebrow')}</p>
				<h2 class="deco-section-title text-4xl">{t('whyHeading')}</h2>
			</div>
			<div class="grid grid-cols-1 gap-8 md:grid-cols-3">
				{
					features.map((feature) => (
						<div class="deco-card deco-frame p-8">
							<div
								class="mb-6 flex h-14 w-14 items-center justify-center rounded-sm border"
								style="border-color: var(--deco-brass); color: var(--deco-brass)"
							>
								<DecoIcon name={feature.icon} size={26} />
							</div>
							<h3 class="deco-section-title mb-3 text-2xl">{feature.title}</h3>
							<p class="deco-body-text">{feature.body}</p>
						</div>
					))
				}
			</div>
		</div>
	</section>

	<!-- Closing CTA -->
	{
		!user && (
			<section class="mx-auto max-w-7xl px-4 py-24 sm:px-6 lg:px-8">
				<div class="deco-panel deco-frame deco-grain relative overflow-hidden px-8 py-16 text-center md:px-16">
					<p class="deco-section-eyebrow mb-5">{t('closingEyebrow')}</p>
					<h2 class="deco-display text-4xl md:text-5xl" set:html={t('closingHeading')} />
					<p class="deco-body-text mx-auto mt-5 max-w-xl text-lg">{t('closingBody')}</p>
					<div class="mt-9 flex justify-center">
						<Button href="/signin" variant="primary">
							{t('ctaStartPlayingFree')}
						</Button>
					</div>
				</div>
			</section>
		)
	}
</CasinoLayout>
