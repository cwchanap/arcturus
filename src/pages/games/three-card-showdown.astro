---
import CasinoLayout from '../../layouts/casino.astro';
import CardSlot from '../../components/CardSlot.astro';
import { createPublicGameSession } from '../../lib/public-game-session';
import { formatChipBalance } from '../../lib/formatting';
import { threeCardShowdownTranslator } from '../../lib/i18n/messages/three-card-showdown';
import { getGameName } from '../../lib/i18n/messages/games';
import { formatChips } from '../../lib/i18n/messages/common';
import { ANTE_OPTIONS } from '../../lib/three-card-showdown';

const locale = Astro.locals.locale;
const t = threeCardShowdownTranslator(locale);
const user = Astro.locals.user;
const gameSession = createPublicGameSession(user);
---

<CasinoLayout title={t('pageTitle', { game: getGameName(locale, 'three-card-showdown') })}>
	<main
		id="three-card-showdown-root"
		data-testid="three-card-showdown-root"
		data-user-id={gameSession.clientUserId}
		data-guest-mode={gameSession.guestModeValue}
		data-initial-balance={gameSession.initialBalance}
		class="mx-auto max-w-6xl px-4 py-8 sm:px-6 lg:px-8"
	>
		<header class="mb-6 flex flex-wrap items-end justify-between gap-4">
			<div>
				<a href="/games" class="text-[var(--deco-muted)]">← {t('backToGames')}</a>
				<h1 class="deco-section-title text-4xl">
					{getGameName(locale, 'three-card-showdown')}
				</h1>
				<p class="text-[var(--deco-muted)]">
					{t('subtitle')}
				</p>
			</div>
			<div class="deco-panel px-5 py-3">
				<div class="text-xs text-[var(--deco-muted)]">{gameSession.balanceLabel}</div>
				<div
					id="chip-balance"
					data-testid="chip-balance"
					class="text-2xl font-bold text-[var(--deco-brass)]"
				>
					{formatChipBalance(gameSession.initialBalance, locale)}
				</div>
			</div>
		</header>

		<section class="felt-table rounded-3xl p-6">
			<div
				id="three-card-showdown-status"
				data-testid="three-card-showdown-status"
				role="status"
				aria-live="polite"
				class="mb-4 text-center"
			>
				{t('chooseAnte')}
			</div>

			<div class="mb-6">
				<div class="mb-2 text-center text-sm text-[var(--deco-muted)]">{t('dealer')}</div>
				<div class="flex justify-center gap-3">
					{
						[0, 1, 2].map((i) => (
							<CardSlot
								id={`three-card-showdown-dealer-slot-${i}`}
								size="large"
								showPlaceholder={true}
							/>
						))
					}
				</div>
			</div>

			<div>
				<div class="mb-2 text-center text-sm text-[var(--deco-muted)]">{t('player')}</div>
				<div class="flex justify-center gap-3">
					{
						[0, 1, 2].map((i) => (
							<CardSlot
								id={`three-card-showdown-player-slot-${i}`}
								size="large"
								showPlaceholder={true}
							/>
						))
					}
				</div>
			</div>

			<div
				id="three-card-showdown-result"
				data-testid="three-card-showdown-result"
				role="status"
				aria-live="polite"
				class="mt-2 min-h-6 text-center font-semibold text-[var(--deco-brass)]"
			>
			</div>

			<div class="mt-5 text-center text-sm text-[var(--deco-muted)]">{t('ante')}</div>
			<div class="mt-2 flex flex-wrap justify-center gap-2">
				{
					ANTE_OPTIONS.map((ante) => (
						<button
							type="button"
							data-ante={ante}
							aria-pressed={ante === ANTE_OPTIONS[0] ? 'true' : 'false'}
							class="deco-btn rounded-lg px-4 py-2"
						>
							{formatChips(ante, locale)}
						</button>
					))
				}
			</div>

			<div class="mt-6 flex flex-wrap items-center justify-center gap-3">
				<button
					id="three-card-showdown-deal"
					data-testid="three-card-showdown-deal"
					type="button"
					class="btn-gold rounded-lg px-8 py-3"
				>
					{t('deal')}
				</button>
				<button
					id="three-card-showdown-fold"
					data-testid="three-card-showdown-fold"
					type="button"
					class="deco-btn rounded-lg px-6 py-3"
					hidden
				>
					{t('fold')}
				</button>
				<button
					id="three-card-showdown-play"
					data-testid="three-card-showdown-play"
					type="button"
					class="btn-gold rounded-lg px-8 py-3"
					hidden
				>
					{t('play')}
				</button>
				<button
					id="three-card-showdown-new-round"
					data-testid="three-card-showdown-new-round"
					type="button"
					class="deco-btn rounded-lg px-8 py-3"
					hidden
				>
					{t('newRound')}
				</button>
			</div>
			<div id="three-card-showdown-recovery-host" class="mt-4 flex justify-center"></div>
		</section>

		<aside class="deco-panel mt-6 p-5">
			<h2 class="deco-section-title text-2xl">{t('howToPlay')}</h2>
			<p class="mt-1 text-xs text-[var(--deco-muted)]">
				{t('howToPlayBody')}
			</p>
		</aside>
	</main>
</CasinoLayout>

<script>
	import { initThreeCardShowdownClient } from '../../lib/three-card-showdown';

	initThreeCardShowdownClient();
</script>
