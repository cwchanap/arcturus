---
/**
 * Language picker over ENABLED_LOCALES. Hidden while only English is enabled;
 * when several locales are enabled, selecting one writes the locale cookie and
 * reloads the current URL. The module script ships always but no-ops while the
 * picker control is not rendered (Astro hoists scripts out of conditionals).
 */
import { ENABLED_LOCALES, type Locale } from '../lib/i18n/locale';

const LOCALE_LABELS: Record<Locale, string> = {
	en: 'English',
	'zh-Hant': '繁體中文',
	'zh-Hans': '简体中文',
	ja: '日本語',
};

const visibleLocales = [...ENABLED_LOCALES];
---

{
	visibleLocales.length > 1 && (
		<select
			class="rounded-md border border-[var(--deco-brass)] bg-transparent px-2 py-1 text-sm font-body"
			data-locale-picker
			aria-label="Language"
		>
			{visibleLocales.map((locale) => (
				<option value={locale}>{LOCALE_LABELS[locale]}</option>
			))}
		</select>
	)
}

<script>
	import { LOCALE_COOKIE } from '../lib/i18n/locale';

	const picker = document.querySelector<HTMLSelectElement>('[data-locale-picker]');
	picker?.addEventListener('change', () => {
		document.cookie =
			LOCALE_COOKIE + '=' + picker.value + '; Max-Age=31536000; Path=/; SameSite=Lax';
		window.location.reload();
	});
</script>
